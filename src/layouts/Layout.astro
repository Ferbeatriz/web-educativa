---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = "Aprende Jugando" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Plataforma educativa interactiva para niñas y niños" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" 
      rel="stylesheet" 
    />
    
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />

    <script>
      /**
       * Validación automática de sesión.
       * Se ejecuta en el cliente al cargar cada página.
       * Si el token expiró o es inválido, limpia la sesión local.
       * 
       * NOTA: Solo valida si hay token. Si no hay, no hace nada.
       * No redirige a /login automáticamente para no romper la navegación.
       */
      import { getToken, verificarSesion } from '../lib/auth';

      const token = getToken();

      if (token) {
        // Validar en segundo plano (no bloquea el render)
        verificarSesion().then((alumna) => {
          if (!alumna) {
            // El token expiró: recargar la página para actualizar el header
            console.info('[auth] Sesión expirada, recargando...');
            window.location.reload();
          }
        });
      }
    </script>
  </body>
</html>
