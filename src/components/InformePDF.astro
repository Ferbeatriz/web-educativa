---
// src/components/InformePDF.astro
---
<div id="informe-pdf-container" class="informe-container">
  <h2 class="titulo">📄 Generar Informe de Progreso</h2>
  <p class="subtitulo">Descarga un resumen del aprendizaje en formato PDF.</p>
  
  <div class="botones">
    <button id="btn-semanal" class="btn-informe" disabled>📅 Última Semana</button>
    <button id="btn-mensual" class="btn-informe" disabled>📆 Último Mes</button>
  </div>

  <div class="rango-personalizado">
    <label>Desde: <input type="date" id="fecha-desde" disabled></label>
    <label>Hasta: <input type="date" id="fecha-hasta" disabled></label>
    <button id="btn-personalizado" class="btn-informe" disabled>Generar Rango</button>
  </div>

  <p id="status-informe" class="status">Módulo en preparación (esperando conexión con el backend)...</p>
</div>

<style>
  .informe-container {
    background: white;
    padding: 2rem;
    border-radius: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-top: 2rem;
  }
  .titulo { font-size: 1.4rem; font-weight: 800; color: #1F2937; margin: 0 0 0.5rem 0; }
  .subtitulo { color: #6B7280; font-size: 0.9rem; margin: 0 0 1.5rem 0; }
  .botones { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .btn-informe {
    background: #8B5CF6; color: white; border: none; padding: 0.75rem 1.5rem;
    border-radius: 8px; cursor: pointer; font-weight: 600; font-family: inherit;
    transition: opacity 0.2s;
  }
  .btn-informe:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-informe:not(:disabled):hover { background: #7C3AED; }
  .rango-personalizado { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; }
  .rango-personalizado input { padding: 0.5rem; border: 1px solid #D1D5DB; border-radius: 6px; }
  .status { margin-top: 1rem; font-size: 0.9rem; color: #6B7280; font-style: italic; }
</style>