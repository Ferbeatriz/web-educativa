---
// src/components/InformePDF.astro
---
<div id="informe-pdf-container" class="informe-container">
  <h2 class="titulo">📄 Generar Informe de Progreso</h2>
  <p class="subtitulo">Descarga un resumen del aprendizaje en formato PDF.</p>
  
  <div class="botones">
    <button id="btn-semanal" class="btn-informe">📅 Última Semana</button>
    <button id="btn-mensual" class="btn-informe">📆 Último Mes</button>
  </div>

  <div class="rango-personalizado">
    <label>Desde: <input type="date" id="fecha-desde"></label>
    <label>Hasta: <input type="date" id="fecha-hasta"></label>
    <button id="btn-personalizado" class="btn-informe">Generar Rango</button>
  </div>

  <p id="status-informe" class="status"></p>
</div>

<script>
  import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';

  async function generarPDF(desde: string, hasta: string) {
    const statusEl = document.getElementById('status-informe');
    if (statusEl) statusEl.textContent = 'Generando informe...';

    const token = localStorage.getItem('web_educativa_token');
    if (!token) {
      if (statusEl) statusEl.textContent = 'Debes iniciar sesión para generar el informe.';
      return;
    }

    try {
      // 1. Pedir datos al Worker
      const res = await fetch(`https://web-educativa-api.ferbeatriz.workers.dev/api/progreso/informe?desde=${desde}&hasta=${hasta}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (!res.ok) {
        const errorText = await res.text();
        throw new Error(`Error ${res.status}: ${errorText}`);
      }
      
      const data = await res.json();

      // 2. Crear el PDF
      const pdfDoc = await PDFDocument.create();
      const page = pdfDoc.addPage([600, 800]);
      const font = await pdfDoc.embedFont(StandardFonts.Helvetica);
      const fontBold = await pdfDoc.embedFont(StandardFonts.HelveticaBold);

      const { width, height } = page.getSize();
      let y = height - 50;
      const margin = 50;

      // Título
      page.drawText('Informe de Progreso Educativo', { x: margin, y, size: 20, font: fontBold, color: rgb(0.3, 0, 0.6) });
      y -= 30;
      
      // Datos de la alumna
      page.drawText(`Alumna: ${data.alumna.nombre}`, { x: margin, y, size: 12, font });
      y -= 20;
      page.drawText(`Período: ${desde} al ${hasta}`, { x: margin, y, size: 12, font });
      y -= 20;
      page.drawText(`Nivel: ${data.resumen.nivel.nombre} (${data.resumen.xp_total} XP)`, { x: margin, y, size: 12, font });
      y -= 40;

      // Lecciones completadas
      page.drawText('Lecciones Completadas:', { x: margin, y, size: 14, font: fontBold });
      y -= 20;
      if (data.lecciones.length === 0) {
        page.drawText('No se completaron lecciones en este período.', { x: margin + 10, y, size: 11, font });
        y -= 20;
      } else {
        data.lecciones.forEach((l: any) => {
          page.drawText(`- ${l.leccion_id} (${l.materia_id})`, { x: margin + 10, y, size: 11, font });
          y -= 18;
        });
      }
      y -= 20;

      // Área de mejora
      if (data.area_de_mejora) {
        page.drawText('Área de Mejora:', { x: margin, y, size: 14, font: fontBold });
        y -= 20;
        page.drawText(`Lección: ${data.area_de_mejora.leccion_id}`, { x: margin + 10, y, size: 11, font });
        y -= 18;
        page.drawText(`Tasa de acierto: ${data.area_de_mejora.tasa_acierto}% (${data.area_de_mejora.correctas}/${data.area_de_mejora.total})`, { x: margin + 10, y, size: 11, font });
        y -= 30;
      }

      // Recomendación
      page.drawText('Recomendación para el Apoderado:', { x: margin, y, size: 14, font: fontBold });
      y -= 20;
      const recText = data.recomendacion || 'Sin recomendaciones por ahora.';
      // Simple wrapping
      const words = recText.split(' ');
      let line = '';
      for (const word of words) {
        if ((line + word).length > 70) {
          page.drawText(line, { x: margin + 10, y, size: 11, font });
          y -= 18;
          line = word + ' ';
        } else {
          line += word + ' ';
        }
      }
      page.drawText(line, { x: margin + 10, y, size: 11, font });

      // 3. Descargar
      const pdfBytes = await pdfDoc.save();
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `informe_${data.alumna.usuario}_${desde}_${hasta}.pdf`;
      a.click();
      URL.revokeObjectURL(url);

      if (statusEl) statusEl.textContent = '¡Informe generado con éxito!';
    } catch (error: any) {
      console.error(error);
      if (statusEl) statusEl.textContent = `Error al generar el informe: ${error.message}`;
    }
  }

  function getFechas(periodo: 'semana' | 'mes') {
    const hoy = new Date();
    const desde = new Date();
    if (periodo === 'semana') desde.setDate(hoy.getDate() - 7);
    else desde.setDate(hoy.getDate() - 30);
    return {
      desde: desde.toISOString().split('T')[0],
      hasta: hoy.toISOString().split('T')[0]
    };
  }

  document.getElementById('btn-semanal')?.addEventListener('click', () => {
    const { desde, hasta } = getFechas('semana');
    generarPDF(desde, hasta);
  });

  document.getElementById('btn-mensual')?.addEventListener('click', () => {
    const { desde, hasta } = getFechas('mes');
    generarPDF(desde, hasta);
  });

  document.getElementById('btn-personalizado')?.addEventListener('click', () => {
    const desde = (document.getElementById('fecha-desde') as HTMLInputElement).value;
    const hasta = (document.getElementById('fecha-hasta') as HTMLInputElement).value;
    if (desde && hasta) {
      generarPDF(desde, hasta);
    } else {
      alert('Selecciona ambas fechas');
    }
  });
</script>

<style>
  .informe-container {
    background: white;
    padding: 2rem;
    border-radius: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    margin-top: 2rem;
  }
  .titulo { font-size: 1.4rem; font-weight: 800; color: #1F2937; margin: 0 0 0.5rem 0; }
  .subtitulo { color: #6B7280; font-size: 0.9rem; margin: 0 0 1.5rem 0; }
  .botones { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .btn-informe {
    background: #8B5CF6; color: white; border: none; padding: 0.75rem 1.5rem;
    border-radius: 8px; cursor: pointer; font-weight: 600; font-family: inherit;
    transition: opacity 0.2s;
  }
  .btn-informe:hover { background: #7C3AED; }
  .rango-personalizado { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; }
  .rango-personalizado input { padding: 0.5rem; border: 1px solid #D1D5DB; border-radius: 6px; }
  .status { margin-top: 1rem; font-size: 0.9rem; color: #6B7280; font-style: italic; }
</style>
