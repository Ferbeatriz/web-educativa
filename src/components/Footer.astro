---
// Footer global de la web
const año = new Date().getFullYear();
---

<footer class="mt-16 border-t border-gray-100 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 py-8 md:py-10">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

      <!-- Identidad -->
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-brand-500 flex items-center justify-center text-base shadow-sm">
          🦊
        </div>
        <span class="font-extrabold text-gray-700 text-sm">
          Aprende Jugando
        </span>
      </div>

      <!-- Mensaje -->
      <p class="text-xs md:text-sm text-gray-500 text-center md:text-right">
        Hecho con 💜 para niñas curiosas
      </p>

    </div>

    <div class="mt-6 pt-5 border-t border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-xs text-gray-400">
      <p>© {año} Aprende Jugando</p>
      <p>Un espacio para aprender, crear y crecer</p>
    </div>

  </div>
</footer>
