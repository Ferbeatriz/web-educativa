<div class="w-full overflow-x-auto py-8">
  <div class="flex flex-row justify-center items-end gap-1 min-w-max mx-auto px-4">
    <div class="relative flex flex-col items-center">
      <button class="tecla-negra absolute -top-5 z-10 w-8 h-12 bg-gray-800 rounded-b-md shadow-md text-white text-[10px] font-bold" data-nota="DO#">DO#</button>
      <button class="w-14 h-36 bg-red-500 rounded-b-lg shadow-lg text-white font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="DO">DO</button>
    </div>
    <div class="relative flex flex-col items-center">
      <button class="tecla-negra absolute -top-5 z-10 w-8 h-12 bg-gray-800 rounded-b-md shadow-md text-white text-[10px] font-bold" data-nota="RE#">RE#</button>
      <button class="w-14 h-36 bg-orange-500 rounded-b-lg shadow-lg text-white font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="RE">RE</button>
    </div>
    <div class="relative flex flex-col items-center">
      <div class="absolute -top-5 w-8 h-12"></div>
      <button class="w-14 h-36 bg-yellow-400 rounded-b-lg shadow-lg text-gray-800 font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="MI">MI</button>
    </div>
    <div class="relative flex flex-col items-center">
      <button class="tecla-negra absolute -top-5 z-10 w-8 h-12 bg-gray-800 rounded-b-md shadow-md text-white text-[10px] font-bold" data-nota="FA#">FA#</button>
      <button class="w-14 h-36 bg-green-500 rounded-b-lg shadow-lg text-white font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="FA">FA</button>
    </div>
    <div class="relative flex flex-col items-center">
      <button class="tecla-negra absolute -top-5 z-10 w-8 h-12 bg-gray-800 rounded-b-md shadow-md text-white text-[10px] font-bold" data-nota="SOL#">SOL#</button>
      <button class="w-14 h-36 bg-teal-400 rounded-b-lg shadow-lg text-white font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="SOL">SOL</button>
    </div>
    <div class="relative flex flex-col items-center">
      <button class="tecla-negra absolute -top-5 z-10 w-8 h-12 bg-gray-800 rounded-b-md shadow-md text-white text-[10px] font-bold" data-nota="LA#">LA#</button>
      <button class="w-14 h-36 bg-blue-500 rounded-b-lg shadow-lg text-white font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="LA">LA</button>
    </div>
    <div class="relative flex flex-col items-center">
      <div class="absolute -top-5 w-8 h-12"></div>
      <button class="w-14 h-36 bg-purple-500 rounded-b-lg shadow-lg text-white font-bold text-lg hover:brightness-110 active:scale-95 transition-all flex items-end justify-center pb-2" data-nota="SI">SI</button>
    </div>
  </div>
</div>

<script>
  let audioCtx = null;
  const frecuencias = { 'DO': 261.63, 'DO#': 277.18, 'RE': 293.66, 'RE#': 311.13, 'MI': 329.63, 'FA': 349.23, 'FA#': 369.99, 'SOL': 392.00, 'SOL#': 415.30, 'LA': 440.00, 'LA#': 466.16, 'SI': 493.88 };

  window.tocarNota = function(nota) {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const freq = frecuencias[nota];
    if (!freq) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.2);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 1.2);
  }

  document.querySelectorAll('[data-nota]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const nota = btn.dataset.nota;
      if (nota) {
        window.tocarNota(nota);
        document.dispatchEvent(new CustomEvent('nota-tocada', { detail: { nota: nota } }));
      }
    });
  });

  document.addEventListener('nota-tocada', (e) => {
    window.tocarNota(e.detail.nota);
  });
</script>
