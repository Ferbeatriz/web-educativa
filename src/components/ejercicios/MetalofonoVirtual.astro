---
// Metalófono virtual: 7 notas naturales con Web Audio API
const notas = [
  { nombre: 'DO', color: 'bg-red-500', freq: 261.63 },
  { nombre: 'RE', color: 'bg-orange-500', freq: 293.66 },
  { nombre: 'MI', color: 'bg-yellow-400', freq: 329.63 },
  { nombre: 'FA', color: 'bg-green-500', freq: 349.23 },
  { nombre: 'SOL', color: 'bg-sky-400', freq: 392.00 },
  { nombre: 'LA', color: 'bg-blue-600', freq: 440.00 },
  { nombre: 'SI', color: 'bg-purple-600', freq: 493.88 },
];
---

<div class="metalofono flex flex-wrap justify-center gap-3 my-4">
  {notas.map((n) => (
    <button
      type="button"
      data-nota={n.nombre}
      data-freq={n.freq}
      class={`metalofono-tecla ${n.color} text-white font-extrabold text-lg w-16 h-24 md:w-20 md:h-28 rounded-2xl shadow-lg hover:scale-105 active:scale-95 transition-transform flex items-end justify-center pb-3`}
    >
      {n.nombre}
    </button>
  ))}
</div>

<script>
  let audioCtx = null;
  function getCtx() {
    if (!audioCtx) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (Ctx) audioCtx = new Ctx();
    }
    return audioCtx;
  }
  function play(freq) {
    const ctx = getCtx();
    if (!ctx) return;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freq;
    const now = ctx.currentTime;
    gain.gain.setValueAtTime(0.6, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
    osc.connect(gain).connect(ctx.destination);
    osc.start(now);
    osc.stop(now + 0.45);
  }
  document.querySelectorAll('.metalofono-tecla').forEach((btn) => {
    btn.addEventListener('click', () => {
      const nota = btn.getAttribute('data-nota');
      const freq = parseFloat(btn.getAttribute('data-freq'));
      play(freq);
      const ev = new CustomEvent('nota-tocada', { detail: { nota }, bubbles: true });
      btn.dispatchEvent(ev);
    });
  });
</script>
