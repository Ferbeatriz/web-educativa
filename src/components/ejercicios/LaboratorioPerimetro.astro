---
// Laboratorio de Perímetro (OA 21) - Modal Flotante
---

<!-- Botón Flotante (FAB) -->
<button id="btn-abrir-perimetro" class="fixed bottom-40 right-6 z-40 bg-blue-600 text-white rounded-full p-4 shadow-lg hover:scale-105 transition flex items-center justify-center text-2xl" title="Laboratorio de Perímetro">
  📏
</button>

<!-- Modal -->
<div id="modal-perimetro" class="fixed inset-0 bg-black/50 z-[100] hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-3xl w-full relative max-h-[90vh] overflow-y-auto">
    <button id="btn-cerrar-perimetro" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-3xl font-bold z-10">&times;</button>
    
    <div class="p-6 md:p-8">
      <h2 class="text-2xl font-extrabold text-gray-800 text-center mb-2">📏 Laboratorio de Perímetro</h2>
      <p class="text-center text-gray-500 mb-6">Imagina que quieres poner una cerca alrededor de una plaza. ¿Cuántos metros de cerca necesitas?</p>

      <!-- Controles -->
      <div class="flex flex-col md:flex-row justify-center gap-6 mb-8 bg-gray-50 p-4 rounded-xl">
        <div class="flex flex-col items-center">
          <label class="text-sm font-bold text-gray-600 mb-2">Base (metros)</label>
          <input type="number" id="per-input-base" min="1" max="10" value="5" class="w-24 text-center text-lg font-bold border-2 border-gray-300 rounded-lg py-2 focus:border-purple-500 focus:outline-none">
        </div>
        <div class="flex flex-col items-center">
          <label class="text-sm font-bold text-gray-600 mb-2">Altura (metros)</label>
          <input type="number" id="per-input-altura" min="1" max="10" value="3" class="w-24 text-center text-lg font-bold border-2 border-gray-300 rounded-lg py-2 focus:border-purple-500 focus:outline-none">
        </div>
      </div>

      <!-- Visualización -->
      <div class="flex flex-col items-center justify-center min-h-[300px] mb-6">
        <div id="per-contenedor-figura" class="relative">
          <span id="per-label-top" class="absolute -top-8 left-1/2 -translate-x-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">5 m</span>
          <span id="per-label-bottom" class="absolute -bottom-8 left-1/2 -translate-x-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">5 m</span>
          <span id="per-label-left" class="absolute top-1/2 -left-12 -translate-y-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">3 m</span>
          <span id="per-label-right" class="absolute top-1/2 -right-12 -translate-y-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">3 m</span>

          <div id="per-figura" class="relative bg-blue-100 border-4 border-dashed border-blue-400 transition-all duration-500 flex items-center justify-center">
            <span class="text-blue-800 font-bold opacity-50 select-none">Perímetro</span>
          </div>
        </div>
      </div>

      <!-- Resultado -->
      <div class="bg-purple-50 border-l-4 border-purple-400 p-4 rounded-r-xl">
        <p class="text-purple-900 font-bold mb-1">Explicación paso a paso:</p>
        <p id="per-resultado-texto" class="text-lg text-purple-800"></p>
      </div>
    </div>
  </div>
</div>

<script>
  const inputBase = document.getElementById('per-input-base') as HTMLInputElement;
  const inputAltura = document.getElementById('per-input-altura') as HTMLInputElement;
  const figura = document.getElementById('per-figura') as HTMLElement;
  const resultadoTexto = document.getElementById('per-resultado-texto') as HTMLElement;

  const labelTop = document.getElementById('per-label-top') as HTMLElement;
  const labelBottom = document.getElementById('per-label-bottom') as HTMLElement;
  const labelLeft = document.getElementById('per-label-left') as HTMLElement;
  const labelRight = document.getElementById('per-label-right') as HTMLElement;

  function actualizarPerimetro() {
    let base = parseInt(inputBase.value) || 1;
    let altura = parseInt(inputAltura.value) || 1;
    
    if (base > 10) base = 10;
    if (altura > 10) altura = 10;
    inputBase.value = base.toString();
    inputAltura.value = altura.toString();

    const escala = 30;
    figura.style.width = `${base * escala}px`;
    figura.style.height = `${altura * escala}px`;

    labelTop.textContent = `${base} m`;
    labelBottom.textContent = `${base} m`;
    labelLeft.textContent = `${altura} m`;
    labelRight.textContent = `${altura} m`;

    const perimetro = base + base + altura + altura;
    resultadoTexto.innerHTML = `
      Para saber el perímetro, sumamos todos los lados de la figura.<br>
      <strong>P = ${base} + ${altura} + ${base} + ${altura} = ${perimetro} metros</strong>.<br>
      <span class="text-sm text-purple-600 mt-2 block">¡Necesitas ${perimetro} metros de cerca!</span>
    `;
  }

  inputBase.addEventListener('input', actualizarPerimetro);
  inputAltura.addEventListener('input', actualizarPerimetro);

  const modal = document.getElementById('modal-perimetro');
  const btnAbrir = document.getElementById('btn-abrir-perimetro');
  const btnCerrar = document.getElementById('btn-cerrar-perimetro');

  if(btnAbrir && modal) {
    btnAbrir.addEventListener('click', () => {
      modal.classList.remove('hidden');
      actualizarPerimetro();
    });
  }

  if(btnCerrar && modal) {
    btnCerrar.addEventListener('click', () => modal.classList.add('hidden'));
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });
  }
</script>