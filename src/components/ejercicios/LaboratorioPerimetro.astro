---
// Laboratorio de Perímetro (OA 21) con dimensiones en los lados
---

<div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 max-w-3xl mx-auto my-8 border border-gray-100">
  <h2 class="text-2xl font-extrabold text-gray-800 text-center mb-2">📏 Laboratorio de Perímetro</h2>
  <p class="text-center text-gray-500 mb-6">Imagina que quieres poner una cerca alrededor de una plaza. ¿Cuántos metros de cerca necesitas?</p>

  <!-- Controles -->
  <div class="flex flex-col md:flex-row justify-center gap-6 mb-8 bg-gray-50 p-4 rounded-xl">
    <div class="flex flex-col items-center">
      <label class="text-sm font-bold text-gray-600 mb-2">Base (metros)</label>
      <input type="number" id="input-base" min="1" max="10" value="5" class="w-24 text-center text-lg font-bold border-2 border-gray-300 rounded-lg py-2 focus:border-purple-500 focus:outline-none">
    </div>
    <div class="flex flex-col items-center">
      <label class="text-sm font-bold text-gray-600 mb-2">Altura (metros)</label>
      <input type="number" id="input-altura" min="1" max="10" value="3" class="w-24 text-center text-lg font-bold border-2 border-gray-300 rounded-lg py-2 focus:border-purple-500 focus:outline-none">
    </div>
  </div>

  <!-- Visualización -->
  <div class="flex flex-col items-center justify-center min-h-[300px] mb-6">
    <!-- Contenedor relativo para poder posicionar los textos de los lados -->
    <div id="contenedor-figura" class="relative">
      
      <!-- Etiquetas de medidas (se posicionan con JS/CSS) -->
      <span id="label-top" class="absolute -top-8 left-1/2 -translate-x-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">5 m</span>
      <span id="label-bottom" class="absolute -bottom-8 left-1/2 -translate-x-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">5 m</span>
      <span id="label-left" class="absolute top-1/2 -left-12 -translate-y-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">3 m</span>
      <span id="label-right" class="absolute top-1/2 -right-12 -translate-y-1/2 bg-white px-2 py-1 rounded shadow-sm border border-gray-200 text-blue-600 font-bold text-sm z-10">3 m</span>

      <!-- La figura en sí -->
      <div id="figura" class="relative bg-blue-100 border-4 border-dashed border-blue-400 transition-all duration-500 flex items-center justify-center">
        <span id="texto-area" class="text-blue-800 font-bold opacity-50 select-none">Área</span>
      </div>
    </div>
  </div>

  <!-- Resultado -->
  <div class="bg-purple-50 border-l-4 border-purple-400 p-4 rounded-r-xl">
    <p class="text-purple-900 font-bold mb-1">Explicación paso a paso:</p>
    <p id="resultado-texto" class="text-lg text-purple-800"></p>
  </div>
</div>

<script>
  const inputBase = document.getElementById('input-base') as HTMLInputElement;
  const inputAltura = document.getElementById('input-altura') as HTMLInputElement;
  const figura = document.getElementById('figura') as HTMLElement;
  const resultadoTexto = document.getElementById('resultado-texto') as HTMLElement;

  // Elementos de las medidas
  const labelTop = document.getElementById('label-top') as HTMLElement;
  const labelBottom = document.getElementById('label-bottom') as HTMLElement;
  const labelLeft = document.getElementById('label-left') as HTMLElement;
  const labelRight = document.getElementById('label-right') as HTMLElement;

  function actualizarPerimetro() {
    let base = parseInt(inputBase.value) || 1;
    let altura = parseInt(inputAltura.value) || 1;
    
    // Validar límites
    if (base > 10) base = 10;
    if (altura > 10) altura = 10;
    inputBase.value = base.toString();
    inputAltura.value = altura.toString();

    // Escalar para que se vea en pantalla (ej. 1 metro = 30px)
    const escala = 30;
    figura.style.width = `${base * escala}px`;
    figura.style.height = `${altura * escala}px`;

    // Actualizar los textos de las medidas
    labelTop.textContent = `${base} m`;
    labelBottom.textContent = `${base} m`;
    labelLeft.textContent = `${altura} m`;
    labelRight.textContent = `${altura} m`;

    // Calcular perímetro
    const perimetro = base + base + altura + altura;
    
    resultadoTexto.innerHTML = `
      Para saber el perímetro, sumamos todos los lados de la figura.<br>
      <strong>P = ${base} + ${altura} + ${base} + ${altura} = ${perimetro} metros</strong>.<br>
      <span class="text-sm text-purple-600 mt-2 block">¡Necesitas ${perimetro} metros de cerca!</span>
    `;
  }

  inputBase.addEventListener('input', actualizarPerimetro);
  inputAltura.addEventListener('input', actualizarPerimetro);

  // Inicializar
  actualizarPerimetro();
</script>