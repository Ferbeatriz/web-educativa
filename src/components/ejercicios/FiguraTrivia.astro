---
interface Props {
  filas: string[];
  color: string;
}
const { filas, color } = Astro.props;
const cols = Math.max(...filas.map(f => f.length));
---

<div class="flex justify-center my-4">
  <div class="grid gap-1" style={`grid-template-columns: repeat(${cols}, 1fr);`}>
    {filas.map((fila) =>
      fila.split('').map((celda) => (
        celda === '1' 
          ? <div class={`w-10 h-10 md:w-12 md:h-12 bg-${color}-400 border border-${color}-500 rounded-sm`}></div>
          : <div class="w-10 h-10 md:w-12 md:h-12 bg-transparent"></div>
      ))
    )}
  </div>
</div>