---
// src/components/ejercicios/OrdenadorFracciones.astro
// Sistema Click-to-Move: hacer clic en una fracción del banco y luego en el slot destino.

const rondas = [
  {
    tipo: 'menor-a-mayor',
    instruccion: 'Ordena de menor a mayor',
    figura: 'circulo',
    fracciones: [
      { texto: '1/4', num: 1, den: 4 },
      { texto: '1/2', num: 1, den: 2 },
      { texto: '3/4', num: 3, den: 4 },
    ],
    ordenEsperado: [0, 1, 2],
  },
  {
    tipo: 'mayor-a-menor',
    instruccion: 'Ordena de mayor a menor',
    figura: 'pentagono',
    fracciones: [
      { texto: '3/5', num: 3, den: 5 },
      { texto: '2/5', num: 2, den: 5 },
      { texto: '1/5', num: 1, den: 5 },
    ],
    ordenEsperado: [0, 1, 2],
  },
  {
    tipo: 'menor-a-mayor',
    instruccion: 'Ordena de menor a mayor',
    figura: 'triangulo',
    fracciones: [
      { texto: '1/3', num: 1, den: 3 },
      { texto: '2/3', num: 2, den: 3 },
      { texto: '3/3', num: 3, den: 3 },
    ],
    ordenEsperado: [0, 1, 2],
  },
  {
    tipo: 'menor-a-mayor',
    instruccion: 'Ordena de menor a mayor',
    figura: 'circulo',
    fracciones: [
      { texto: '2/8', num: 2, den: 8 },
      { texto: '5/8', num: 5, den: 8 },
      { texto: '7/8', num: 7, den: 8 },
    ],
    ordenEsperado: [0, 1, 2],
  },
  {
    tipo: 'mayor-a-menor',
    instruccion: 'Ordena de mayor a menor',
    figura: 'cuadrado',
    fracciones: [
      { texto: '4/6', num: 4, den: 6 },
      { texto: '3/6', num: 3, den: 6 },
      { texto: '1/6', num: 1, den: 6 },
    ],
    ordenEsperado: [0, 1, 2],
  },
];
---

<div id="ordenador-fracciones" class="max-w-2xl mx-auto space-y-8 text-center" data-rondas={JSON.stringify(rondas)}>
  <div class="flex flex-col items-center gap-2">
    <h2 class="text-xl font-extrabold text-gray-800">Ordena las fracciones</h2>
    <p id="tipo-contador" class="text-sm text-gray-500">Ronda <span id="ronda-actual">1</span> de 5</p>
  </div>

  <div id="instruccion" class="text-base font-bold text-gray-700 mb-6"></div>

  <!-- Slots: 3 casillas vacías -->
  <div id="slots-contenedor" class="flex justify-center gap-4 mb-8">
    <div id="slot-0" class="slot w-28 h-28 rounded-2xl border-4 border-dashed border-gray-300 bg-white flex flex-col items-center justify-center text-gray-400 transition-all cursor-pointer" data-slot="0" data-filled="false"></div>
    <div id="slot-1" class="slot w-28 h-28 rounded-2xl border-4 border-dashed border-gray-300 bg-white flex flex-col items-center justify-center text-gray-400 transition-all cursor-pointer" data-slot="1" data-filled="false"></div>
    <div id="slot-2" class="slot w-28 h-28 rounded-2xl border-4 border-dashed border-gray-300 bg-white flex flex-col items-center justify-center text-gray-400 transition-all cursor-pointer" data-slot="2" data-filled="false"></div>
  </div>

  <!-- Banco de fracciones -->
  <div id="banco-label" class="text-sm font-semibold text-gray-600 mb-2">Toca una fracción y luego el slot donde va</div>
  <div id="banco" class="flex flex-wrap justify-center gap-3"></div>

  <div id="feedback" class="hidden space-y-3"></div>
  <div id="resultado-final" class="hidden space-y-4"></div>
</div>

<script>
  const rondas = JSON.parse(document.getElementById('ordenador-fracciones').dataset.rondas);

  let rondaIdx = 0;
  let respondiendo = true;
  let tarjetaSeleccionada = null;
  let aciertosEnRonda = 0;

  const instruccionEl = document.getElementById('instruccion');
  const rondaActual = document.getElementById('ronda-actual');
  const banco = document.getElementById('banco');
  const feedback = document.getElementById('feedback');
  const resultadoFinal = document.getElementById('resultado-final');

  const slots = [
    document.getElementById('slot-0'),
    document.getElementById('slot-1'),
    document.getElementById('slot-2'),
  ];

  function renderForma(tipo, num, den) {
    const pct = Math.round((num / den) * 100);
    if (tipo === 'circulo') {
      return `<div class="relative w-12 h-12" style="background: conic-gradient(#3b82f6 0% ${pct}%, #f1f5f9 ${pct}% 100%); border-radius: 50%; border: 2px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.7rem; color: #475569;">${Math.floor(pct)}%</div>`;
    }
    if (tipo === 'cuadrado') {
      const bloques = Array.from({ length: den }, (_, i) =>
        i < num ? '<div class="w-5 h-5 bg-blue-500"></div>' : '<div class="w-5 h-5 bg-white border border-gray-300"></div>'
      ).join('');
      const cols = den <= 4 ? den : 5;
      return `<div class="grid grid-cols-${cols} gap-1 w-16 h-6">${bloques}</div>`;
    }
    if (tipo === 'pentagono') {
      const partes = [];
      for (let i = 0; i < 5; i++) {
        const fill = i < num ? '#3b82f6' : '#f1f5f9';
        partes.push(`<path d="M50 50 L${i === 0 ? '50 5' : i === 1 ? '95 40' : i === 2 ? '80 95' : i === 3 ? '20 95' : '5 40'} L${i === 0 ? '95 40' : i === 1 ? '80 95' : i === 2 ? '20 95' : i === 3 ? '5 40' : '50 5'} Z" fill="${fill}" />`);
      }
      return `<svg viewBox="0 0 100 100" class="w-12 h-12" style="border: 2px solid #e2e8f0;">
        <path d="M50 5 L95 40 L80 95 L20 95 L5 40 Z" fill="none" stroke="#cbd5e1" stroke-width="2"/>
        ${partes.join('')}
      </svg>`;
    }
    if (tipo === 'triangulo') {
      const partes = [];
      for (let i = 0; i < 3; i++) {
        const fill = i < num ? '#3b82f6' : '#f1f5f9';
        partes.push(`<path d="M50 55 L${i === 0 ? '50 10' : i === 1 ? '95 95' : '5 95'} L${i === 0 ? '95 95' : i === 1 ? '5 95' : '50 10'} Z" fill="${fill}" />`);
      }
      return `<svg viewBox="0 0 100 100" class="w-12 h-12" style="border: 2px solid #e2e8f0;">
        <path d="M50 10 L95 95 L5 95 Z" fill="none" stroke="#cbd5e1" stroke-width="2"/>
        ${partes.join('')}
      </svg>`;
    }
    return `<div class="w-10 h-10 bg-blue-500"></div>`;
  }

  function renderRonda() {
    respondiendo = true;
    tarjetaSeleccionada = null;
    aciertosEnRonda = 0;
    feedback.classList.add('hidden');
    feedback.innerHTML = '';
    resultadoFinal.classList.add('hidden');
    resultadoFinal.innerHTML = '';

    if (rondaIdx >= rondas.length) {
      mostrarResultadoFinal();
      return;
    }

    const r = rondas[rondaIdx];
    rondaActual.textContent = rondaIdx + 1;
    instruccionEl.textContent = r.instruccion;

    // LIMPIEZA COMPLETA: vaciar slots y banco antes de dibujar la nueva ronda
    slots.forEach((slot) => {
      slot.innerHTML = '';
      slot.dataset.filled = 'false';
      slot.className = 'slot w-28 h-28 rounded-2xl border-4 border-dashed border-gray-300 bg-white flex flex-col items-center justify-center text-gray-400 transition-all cursor-pointer';
    });
    banco.innerHTML = '';

    // Dibujar tarjetas en el banco
    r.fracciones.forEach((f, i) => {
      const card = document.createElement('div');
      card.dataset.idx = i;
      card.className = 'banco-card flex flex-col items-center gap-1 w-20 h-28 rounded-xl border-2 border-gray-300 bg-white cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition-all';
      card.innerHTML = renderForma(r.figura, f.num, f.den) + `<span class="text-xs font-bold text-gray-800 leading-none">${f.texto}</span>`;

      card.addEventListener('click', () => {
        if (!respondiendo) return;
        seleccionarFraccion(i);
      });

      banco.appendChild(card);
    });

    // Configurar slots con eventos de click directo (sin clonar)
    slots.forEach((slot, si) => {
      slot.onclick = () => {
        if (!respondiendo) return;
        if (slot.dataset.filled === 'true' || tarjetaSeleccionada === null) return;

        const idx = tarjetaSeleccionada;

        if (r.ordenEsperado[si] === idx) {
          // CORRECTO
          slot.classList.remove('border-dashed', 'border-gray-300');
          slot.classList.add('slot-filled', 'border-green-500');
          slot.dataset.filled = 'true';

          const card = banco.querySelector(`[data-idx="${idx}"]`);
          if (card) {
            slot.appendChild(card);
            card.classList.remove('cursor-pointer', 'hover:border-blue-400', 'tarjeta-seleccionada');
            card.classList.add('border-green-500', 'bg-green-50', 'pointer-events-none');
          }

          tarjetaSeleccionada = null;
          aciertosEnRonda++; // SUMAMOS UN ACIERTO

          // Si llegamos a 3 aciertos, mostramos el botón
          if (aciertosEnRonda === 3) {
            respondiendo = false;
            feedback.classList.remove('hidden');
            feedback.innerHTML = `
              <div class="flex items-center gap-2 justify-center p-4">
                <span class="text-3xl">✅</span>
                <span class="font-bold text-green-700 text-xl">¡Ronda completada!</span>
              </div>
              <button id="btn-siguiente" class="mt-2 px-8 py-4 rounded-xl bg-blue-600 text-white font-bold text-lg hover:bg-blue-700 transition-colors w-full max-w-xs mx-auto block">Siguiente ronda →</button>
            `;
            document.getElementById('btn-siguiente').onclick = () => {
              rondaIdx++;
              renderRonda();
            };
          }
        } else {
          // INCORRECTO
          const card = banco.querySelector(`[data-idx="${idx}"]`);
          if (card) {
            card.classList.add('border-red-500', 'bg-red-50');
            card.classList.remove('tarjeta-seleccionada');
            setTimeout(() => {
              card.classList.remove('border-red-500', 'bg-red-50');
            }, 600);
          }
          tarjetaSeleccionada = null;
        }
      };
    });
  }

  function seleccionarFraccion(idx) {
    banco.querySelectorAll('.banco-card').forEach((c) => {
      c.classList.remove('banco-selected', 'ring-2', 'ring-blue-500');
    });

    tarjetaSeleccionada = idx;
    const card = banco.querySelector(`[data-idx="${idx}"]`);
    if (card) {
      card.classList.add('banco-selected', 'ring-2', 'ring-blue-500');
    }
  }

  function mostrarFeedback(msg, tipo = 'error') {
    feedback.classList.remove('hidden');
    const color = tipo === 'warn' ? 'text-yellow-700 bg-yellow-50' : 'text-red-700 bg-red-50';
    feedback.innerHTML = `
      <div class="flex items-center gap-2 justify-center p-2 rounded-lg ${color}">
        <span class="text-xl">${tipo === 'warn' ? '⚠️' : '❌'}</span>
        <span class="font-bold text-sm">${msg}</span>
      </div>
    `;
    setTimeout(() => { feedback.classList.add('hidden'); feedback.innerHTML = ''; }, 2000);
  }

  function mostrarResultadoFinal() {
    slots.forEach((slot) => {
      slot.innerHTML = '';
      slot.dataset.filled = 'false';
      slot.className = 'slot w-24 h-24 rounded-2xl border-2 border-dashed border-gray-300 bg-white flex flex-col items-center justify-center text-sm text-gray-400';
    });
    banco.innerHTML = '';
    instruccionEl.textContent = '';
    resultadoFinal.classList.remove('hidden');
    resultadoFinal.innerHTML = `
      <div class="text-4xl mb-2">🎉</div>
      <h3 class="text-2xl font-extrabold text-gray-800 mb-2">¡Completaste las 5 rondas!</h3>
      <p class="text-gray-600">Ya sabes ordenar fracciones de menor a mayor y de mayor a menor.</p>
    `;
  }

  renderRonda();
</script>