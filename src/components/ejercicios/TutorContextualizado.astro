---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

// Extraemos los datos para armar la pizarra
const dividendo = problema.dividendo;
const divisor = problema.divisor;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;

// Para el problema de ejemplo (248 / 4), calculamos las partes de la división
const primerasDosCifras = Math.floor(dividendo / 10);
const primeraResta = Math.floor(primerasDosCifras / divisor) * divisor;
const primerResultado = primerasDosCifras - primeraResta;
const segundaCifra = dividendo % 10;
const numeroBajado = parseInt(`${primerResultado}${segundaCifra}`);
const segundaResta = Math.floor(numeroBajado / divisor) * divisor;

// Convertimos a strings para mostrar en la pizarra
const strDividendo = dividendo.toString();
const strCociente = cociente.toString();
const strDivisor = divisor.toString();
const strPrimeraResta = primeraResta.toString();
const strPrimerResultado = primerResultado.toString();
const strNumeroBajado = numeroBajado.toString();
const strSegundaResta = segundaResta.toString();
const strResto = resto.toString();
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA (Siempre visible) -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    <div class="pizarra-contenido">
      
      <!-- Ecuación inicial completa: 248 : 4 = 62 -->
      <div class="ecuacion-inicial">
        <span class="resaltado-amarillo">{strDividendo}</span>
        <span> : </span>
        <span class="resaltado-azul">{strDivisor}</span>
        <span> = </span>
        <span class="resaltado-morado cociente-inicial hidden" id={`cociente-inicial-${problema.id}`}>{strCociente}</span>
      </div>

      <!-- Cuenta larga (se va armando) -->
      <div class="cuenta-larga">
        
        <!-- Fila del dividendo y primera resta -->
        <div class="fila-cuenta">
          <div class="columna-numeros">
            <!-- 248 (Se tacha o se deja) -->
            <div class="numero-dividendo" id={`div-${problema.id}`}>
              {strDividendo}
            </div>
            
            <!-- - 24 -->
            <div class="resta hidden" id={`resta1-${problema.id}`}>
              <span class="simbolo">-</span> {strPrimeraResta}
            </div>
            <div class="linea-cuenta hidden" id={`linea1-${problema.id}`}></div>
            
            <!-- 08 (Resultado de la primera resta) -->
            <div class="resultado hidden" id={`res1-${problema.id}`}>
              {strPrimerResultado}
            </div>
            
            <!-- - 08 (Segunda resta, se activa cuando se baja el 8) -->
            <div class="resta hidden" id={`resta2-${problema.id}`}>
              <span class="simbolo">-</span> {strSegundaResta}
            </div>
            <div class="linea-cuenta hidden" id={`linea2-${problema.id}`}></div>
            
            <!-- 0 (Resto final) -->
            <div class="resto hidden" id={`res2-${problema.id}`}>
              {strResto}
            </div>
          </div>
        </div>

      </div>

      <!-- Etiqueta de "Resto" al final -->
      <div class="etiqueta-resto hidden" id={`etiqueta-resto-${problema.id}`}>
        Resto
      </div>

    </div>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      // Referencias a los elementos de la pizarra
      const cocienteInicial = tutor.querySelector(`#cociente-inicial-${problemaId}`);
      const resta1 = tutor.querySelector(`#resta1-${problemaId}`);
      const linea1 = tutor.querySelector(`#linea1-${problemaId}`);
      const res1 = tutor.querySelector(`#res1-${problemaId}`);
      const resta2 = tutor.querySelector(`#resta2-${problemaId}`);
      const linea2 = tutor.querySelector(`#linea2-${problemaId}`);
      const res2 = tutor.querySelector(`#res2-${problemaId}`);
      const etiquetaResto = tutor.querySelector(`#etiqueta-resto-${problemaId}`);

      // Mostrar el primer paso
      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      // Función para revelar paso a paso
      function actualizarPizarra(pasoTerminado: number) {
        // Al terminar el Paso 1, mostramos el cociente completo y la primera resta
        if (pasoTerminado === 1) {
          cocienteInicial?.classList.remove('hidden');
          resta1?.classList.remove('hidden');
          linea1?.classList.remove('hidden');
          res1?.classList.remove('hidden');
        }
        // Al terminar el Paso 2, mostramos la segunda resta (bajamos el 8)
        else if (pasoTerminado === 2) {
          resta2?.classList.remove('hidden');
          linea2?.classList.remove('hidden');
        }
        // Al terminar el Paso 3, mostramos el resto final
        else if (pasoTerminado === 3) {
          res2?.classList.remove('hidden');
          etiquetaResto?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fff;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', Courier, monospace;
  }

  .pizarra-contenido {
    display: inline-flex;
    flex-direction: column;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
  }

  /* Ecuación inicial (147 : 4 = 36) */
  .ecuacion-inicial {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  .resaltado-amarillo { background: #fef08a; padding: 0.1rem 0.3rem; border-radius: 4px; }
  .resaltado-azul { background: #bae6fd; padding: 0.1rem 0.3rem; border-radius: 4px; }
  .resaltado-morado { background: #e9d5ff; padding: 0.1rem 0.3rem; border-radius: 4px; }

  /* Cuenta larga */
  .cuenta-larga {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 150px;
  }

  .columna-numeros {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .numero-dividendo {
    color: #1e293b;
  }

  .resta {
    display: flex;
    gap: 0.5rem;
    color: #dc2626;
    margin-top: 0.2rem;
  }

  .simbolo {
    margin-right: 0.5rem;
  }

  .linea-cuenta {
    width: 100%;
    border-top: 2px solid #1e293b;
    margin: 0.2rem 0;
  }

  .resultado {
    color: #1e293b;
  }

  .resto {
    color: #ea580c;
  }

  .etiqueta-resto {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    font-family: sans-serif;
    color: #ea580c;
    text-transform: uppercase;
    text-align: right;
  }

  .hidden { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>