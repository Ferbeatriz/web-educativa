---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;

// Cálculos para el problema (asumiendo 248 / 4)
const primeraCifra = Math.floor(dividendo / 100);
const dosPrimeras = Math.floor(dividendo / 10);
const primeraResta = Math.floor(dosPrimeras / divisor) * divisor;
const primerResultado = dosPrimeras - primeraResta;
const segundaCifra = dividendo % 10;
const numeroBajado = parseInt(`${primerResultado}${segundaCifra}`);
const segundaResta = Math.floor(numeroBajado / divisor) * divisor;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    
    <div class="cuadricula-division">
      <!-- Columna izquierda: La cuenta -->
      <div class="lado-izquierdo">
        
        <!-- Fila 0: El dividendo inicial -->
        <div class="fila-dividendo">
          <span>{dividendo}</span>
        </div>

        <!-- Fila 1: Primera resta -->
        <div class="fila-resta hidden" id={`resta1-${problema.id}`}>
          <span class="numero-resta">- {primeraResta}</span>
          <div class="linea-horizontal"></div>
          <span class="resultado-resta">{String(primerResultado).padStart(2, '0')}</span>
        </div>

        <!-- Fila 2: Bajar el 8 -->
        <div class="fila-resta hidden" id={`bajada-${problema.id}`}>
          <span class="numero-bajado">{String(primerResultado).padStart(2, '0')}{segundaCifra}</span>
        </div>

        <!-- Fila 3: Segunda resta -->
        <div class="fila-resta hidden" id={`resta2-${problema.id}`}>
          <span class="numero-resta">- {Math.floor(numeroBajado / divisor) * divisor}</span>
          <div class="linea-horizontal"></div>
          <span class="resultado-resta">{resto}</span>
        </div>

      </div>

      <!-- Columna derecha: Divisor y Cociente -->
      <div class="lado-derecho">
        <!-- Cociente (se va armando) -->
        <div class="cociente-actual" id={`cociente-${problema.id}`}></div>
        <!-- Divisor (siempre fijo) -->
        <div class="divisor-fijo">{divisor}</div>
      </div>
    </div>

  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      // Referencias a la pizarra
      const cocienteDiv = tutor.querySelector(`#cociente-${problemaId}`);
      const resta1 = tutor.querySelector(`#resta1-${problemaId}`);
      const bajada = tutor.querySelector(`#bajada-${problemaId}`);
      const resta2 = tutor.querySelector(`#resta2-${problemaId}`);

      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      function actualizarPizarra(pasoTerminado: number) {
        if (pasoTerminado === 1) {
          // Al terminar Paso 1, agregamos el 6 al cociente.
          if (cocienteDiv) cocienteDiv.textContent = '6';
        }
        else if (pasoTerminado === 2) {
          // Al terminar Paso 2, mostramos la primera resta.
          resta1?.classList.remove('hidden');
        }
        else if (pasoTerminado === 3) {
          // Al terminar Paso 3, bajamos el 8.
          bajada?.classList.remove('hidden');
        }
        else if (pasoTerminado === 4) {
          // Al terminar Paso 4, completamos el cociente (62) y mostramos la segunda resta.
          if (cocienteDiv) cocienteDiv.textContent = '62';
          resta2?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .cuadricula-division {
    display: flex;
    align-items: flex-start;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.8rem;
    font-weight: bold;
    color: #1e293b;
    line-height: 1.2;
  }

  /* Lado izquierdo: los números y las restas */
  .lado-izquierdo {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 0.5rem;
  }

  .fila-dividendo {
    padding-right: 0;
  }

  .fila-resta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 100%;
  }

  .numero-resta {
    color: #dc2626;
  }

  .linea-horizontal {
    width: 100%;
    border-top: 3px solid #1e293b;
    margin: 0.2rem 0;
  }

  .resultado-resta {
    color: #16a34a;
  }

  .numero-bajado {
    color: #1e293b;
    margin-top: 0.2rem;
  }

  /* Lado derecho: divisor y cociente */
  .lado-derecho {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-left: 3px solid #1e293b;
    padding-left: 0.5rem;
  }

  .cociente-actual {
    color: #2563eb;
    border-bottom: 3px solid #1e293b;
    width: 100%;
    min-height: 2rem;
    margin-bottom: 0.2rem;
    text-align: left;
    letter-spacing: 0.1em;
  }

  .divisor-fijo {
    color: #1e293b;
  }

  .hidden { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>