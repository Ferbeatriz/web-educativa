---
import ManipulativoDivision from './ManipulativoDivision.astro';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;
---

<div class="manipulativo-solo">
  <!-- MANIPULATIVO DIGITAL (única herramienta visible) -->
  <ManipulativoDivision dividendo={dividendo} divisor={divisor} cocienteEsperado={cociente} problemaId={problema.id} visible={true} />
</div>



<style>
  .manipulativo-solo {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }
</style>