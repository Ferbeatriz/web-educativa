---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

// Descomponemos el dividendo (asumiendo 3 cifras para 248)
const cifras = String(problema.dividendo).split("").map(Number);

// Geometría fija del lienzo para alinear todo
const xInicio = 40;
const anchoCol = 40;
const yFila = 50;
const altoFila = 45;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA (Controlada por el tutor) -->
  <div class="pizarra-viva">
    <svg viewBox="0 0 350 300" class="svg-division">
      
      <!-- Fila 1: El dividendo y el divisor (Siempre visible) -->
      <text x={xInicio} y={yFila} class="num">{cifras[0]}</text>
      <text x={xInicio + anchoCol} y={yFila} class="num">{cifras[1]}</text>
      <text x={xInicio + anchoCol * 2} y={yFila} class="num">{cifras[2]}</text>
      
      <text x={xInicio + anchoCol * 3 + 20} y={yFila} class="simbolo">:</text>
      <text x={xInicio + anchoCol * 4 + 20} y={yFila} class="num texto-azul">{problema.divisor}</text>

      <text x={xInicio + anchoCol * 4 + 70} y={yFila} class="simbolo">=</text>
      
    
      <!-- Primer dígito del cociente (se revela en el Paso 1) -->
      <text x={xInicio + anchoCol * 5 + 60} y={yFila} class="num texto-azul oculto" id="svg-coc1">6</text>
      
      <!-- Segundo dígito del cociente (se revela en el Paso 4) -->
      <text x={xInicio + anchoCol * 5 + 85} y={yFila} class="num texto-azul oculto" id="svg-coc2">2</text>

      <!-- Fila 2: Primera resta (- 24) -->
      <g class="oculto" id="svg-resta1">
        <text x={xInicio - 20} y={yFila + altoFila} class="simbolo texto-rojo">-</text>
        <text x={xInicio} y={yFila + altoFila} class="num texto-rojo">{cifras[0]}</text>
        <text x={xInicio + anchoCol} y={yFila + altoFila} class="num texto-rojo">{cifras[1]}</text>
      </g>

      <!-- Línea 1 -->
      <line x1={xInicio - 25} y1={yFila + altoFila + 10} x2={xInicio + anchoCol * 2 + 15} y2={yFila + altoFila + 10} class="linea oculto" id="svg-linea1" />

      <!-- Fila 3: Resultado 00 -->
      <g class="oculto" id="svg-res1">
        <text x={xInicio + anchoCol} y={yFila + altoFila * 2} class="num">0</text>
        <text x={xInicio + anchoCol * 2} y={yFila + altoFila * 2} class="num">0</text>
      </g>

      <!-- Fila 4: Bajar el 8 (008) -->
      <g class="oculto" id="svg-bajada">
        <text x={xInicio + anchoCol * 2} y={yFila + altoFila * 3} class="num">{cifras[2]}</text>
      </g>

      <!-- Fila 5: Segunda resta (- 8) -->
      <g class="oculto" id="svg-resta2">
        <text x={xInicio + anchoCol - 20} y={yFila + altoFila * 4} class="simbolo texto-rojo">-</text>
        <text x={xInicio + anchoCol * 2} y={yFila + altoFila * 4} class="num texto-rojo">{cifras[2]}</text>
      </g>

      <!-- Línea 2 -->
      <line x1={xInicio + anchoCol - 25} y1={yFila + altoFila * 4 + 10} x2={xInicio + anchoCol * 2 + 15} y2={yFila + altoFila * 4 + 10} class="linea oculto" id="svg-linea2" />

      <!-- Fila 6: Resultado final 0 -->
      <g class="oculto" id="svg-res2">
        <text x={xInicio + anchoCol * 2} y={yFila + altoFila * 5} class="num texto-verde">0</text>
      </g>

    </svg>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item oculto" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso oculto"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      // Referencias al SVG
      const svgCoc1 = tutor.querySelector('#svg-coc1');
      const svgCoc2 = tutor.querySelector('#svg-coc2');
      const svgResta1 = tutor.querySelector('#svg-resta1');
      const svgLinea1 = tutor.querySelector('#svg-linea1');
      const svgRes1 = tutor.querySelector('#svg-res1');
      const svgBajada = tutor.querySelector('#svg-bajada');
      const svgResta2 = tutor.querySelector('#svg-resta2');
      const svgLinea2 = tutor.querySelector('#svg-linea2');
      const svgRes2 = tutor.querySelector('#svg-res2');

      if (pasos.length > 0) pasos[0].classList.remove('oculto');

      // Función maestra que controla la pizarra según el paso terminado
            function actualizarPizarra(pasoTerminado: number) {
        // Paso 1: La niña responde que cabe 6 veces. Mostramos el primer 6 del cociente.
        if (pasoTerminado === 1) {
          svgCoc1?.classList.remove('oculto');
        }
        // Paso 2: La niña calcula 4x6=24. Mostramos la resta.
        else if (pasoTerminado === 2) {
          svgResta1?.classList.remove('oculto');
          svgLinea1?.classList.remove('oculto');
        }
        // Paso 3: La niña resta 24-24=00. Mostramos el resultado y bajamos el 8.
        else if (pasoTerminado === 3) {
          svgRes1?.classList.remove('oculto');
          svgBajada?.classList.remove('oculto');
        }
        // Paso 4: La niña calcula 4x2=8. Mostramos el segundo 2 del cociente.
        else if (pasoTerminado === 4) {
          svgCoc2?.classList.remove('oculto');
        }
        // Paso 5: La niña resta 8-8=0. Mostramos la segunda resta y su resultado.
        else if (pasoTerminado === 5) {
          svgResta2?.classList.remove('oculto');
          svgLinea2?.classList.remove('oculto');
          svgRes2?.classList.remove('oculto');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('oculto');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('oculto');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('oculto');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: flex-start;
  }

  .svg-division {
    width: 100%;
    max-width: 400px;
    height: auto;
    font-family: 'Courier New', Courier, monospace;
    font-size: 24px;
    font-weight: bold;
  }

  .num {
    fill: #1e293b;
    text-anchor: middle;
  }

  .texto-azul { fill: #2563eb; }
  .texto-rojo { fill: #dc2626; }
  .texto-verde { fill: #16a34a; }

  .simbolo {
    fill: #64748b;
    text-anchor: middle;
  }

  .linea {
    stroke: #1e293b;
    stroke-width: 3;
  }

  .oculto { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
