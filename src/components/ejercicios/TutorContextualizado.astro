---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;
const guionPizarra = problema.pizarra || []; // Leemos el nuevo campo
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    
    <div class="planteamiento-inicial">
      <span class="resaltado-amarillo">{dividendo}</span> : 
      <span class="resaltado-azul">{divisor}</span> = 
      <span class="resaltado-morado cociente-final hidden" id={`cociente-final-${problema.id}`}>{cociente}</span>
      <span class="signo-pregunta cociente-final" id={`pregunta-${problema.id}`}>?</span>
    </div>

    <div class="pizarra-layout">
      <!-- Columna izquierda: La cuenta matemática -->
      <div class="columna-matematica">
        
        <div class="fila-numero">
          <span class="cifra-24" id={`cifra24-${problema.id}`}>{Math.floor(dividendo / 10)}</span>
          <span class="cifra-8" id={`cifra8-${problema.id}`}>{dividendo % 10}</span>
        </div>

        <div class="cuenta-larga hidden" id={`resta1-${problema.id}`}>
          <div class="numero">- {Math.floor(Math.floor(dividendo / 10) / divisor) * divisor}</div>
          <div class="linea"></div>
          <div class="resultado">00</div>
        </div>

        <div class="bajada hidden" id={`bajada-${problema.id}`}>
          008
        </div>

        <div class="cuenta-larga hidden" id={`resta2-${problema.id}`}>
          <div class="numero">- {Math.floor((dividendo % 10) / divisor) * divisor}</div>
          <div class="linea"></div>
          <div class="resultado">{resto}</div>
        </div>
      </div>

      <!-- Columna derecha: Las explicaciones flotantes (dinámicas desde el JSON) -->
      <div class="columna-explicaciones">
        {guionPizarra.map((item: any) => (
          <div class="explicacion hidden" id={`exp-${item.paso}-${problema.id}`} data-paso={item.paso}>
            {item.texto}
          </div>
        ))}
      </div>
    </div>

  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      // Elementos visuales
      const cocienteFinal = tutor.querySelector(`#cociente-final-${problemaId}`);
      const pregunta = tutor.querySelector(`#pregunta-${problemaId}`);
      const resta1 = tutor.querySelector(`#resta1-${problemaId}`);
      const bajada = tutor.querySelector(`#bajada-${problemaId}`);
      const resta2 = tutor.querySelector(`#resta2-${problemaId}`);
      
      // Explicaciones dinámicas
      const explicaciones = Array.from(tutor.querySelectorAll('.explicacion')) as HTMLElement[];

      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      // Mostrar la explicación inicial (Paso 1) antes de que conteste
      const expInicial = explicaciones.find(el => el.getAttribute('data-paso') === '1');
      if (expInicial) expInicial.classList.remove('hidden');

      function actualizarPizarra(pasoTerminado: number) {
        // Mostrar la explicación correspondiente al paso terminado
        const expActiva = explicaciones.find(el => el.getAttribute('data-paso') === pasoTerminado.toString());
        if (expActiva) expActiva.classList.remove('hidden');

        // Mostrar los elementos matemáticos
        if (pasoTerminado === 1) {
          resta1?.classList.remove('hidden');
        }
        else if (pasoTerminado === 2) {
          bajada?.classList.remove('hidden');
        }
        else if (pasoTerminado === 3) {
          resta2?.classList.remove('hidden');
        }
        else if (pasoTerminado === 4) {
          pregunta?.classList.add('hidden');
          cocienteFinal?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  /* Los estilos se mantienen igual a tu última versión exitosa */
  .tutor-wrapper { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; margin-top: 1rem; }
  .tutor-header { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  .pizarra-viva { background: #fffbeb; border: 2px dashed #fcd34d; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .planteamiento-inicial { font-family: 'Courier New', Courier, monospace; font-size: 2rem; font-weight: bold; margin-bottom: 1.5rem; color: #1e293b; }
  .resaltado-amarillo { background: #fef08a; padding: 0.1rem 0.3rem; border-radius: 4px; }
  .resaltado-azul { background: #bae6fd; padding: 0.1rem 0.3rem; border-radius: 4px; }
  .resaltado-morado { background: #e9d5ff; padding: 0.1rem 0.3rem; border-radius: 4px; }

  .pizarra-layout { display: flex; gap: 2rem; }
  .columna-matematica { font-family: 'Courier New', Courier, monospace; font-size: 1.5rem; font-weight: bold; color: #1e293b; display: flex; flex-direction: column; gap: 0.2rem; min-width: 150px; }
  .fila-numero { display: flex; position: relative; }
  .cifra-24 { background: #fef08a; padding: 0 0.2rem; border-radius: 4px; }
  .cifra-8 { padding: 0 0.2rem; }

  .columna-explicaciones { font-family: sans-serif; font-size: 0.9rem; color: #475569; display: flex; flex-direction: column; padding-top: 0.5rem; border-left: 2px solid #fcd34d; padding-left: 1rem; }
  .explicacion { background: #fef3c7; padding: 0.4rem 0.6rem; border-radius: 6px; font-style: italic; margin-bottom: 0.8rem; width: fit-content; border: 1px solid #fde68a; }

  .cuenta-larga { display: flex; flex-direction: column; align-items: flex-end; width: fit-content; margin-left: 2rem; }
  .numero { color: #dc2626; }
  .linea { border-top: 2px solid #1e293b; width: 100%; margin: 0.1rem 0; }
  .resultado { color: #16a34a; }
  .bajada { color: #1e293b; display: flex; gap: 0.1rem; margin-left: 2rem; font-size: 1.5rem; font-weight: bold;}
  .hidden { display: none !important; }

  .paso-item { background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .paso-badge { display: inline-block; background: #3b82f6; color: white; font-size: 0.75rem; font-weight: bold; padding: 0.2rem 0.6rem; border-radius: 999px; margin-bottom: 0.5rem; }
  .paso-pregunta { font-size: 1rem; color: #334155; margin-bottom: 1rem; line-height: 1.5; }
  .opciones-grid { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .btn-opcion { background: white; border: 2px solid #cbd5e1; border-radius: 8px; padding: 0.5rem 1rem; font-size: 1rem; font-weight: 600; color: #475569; cursor: pointer; transition: all 0.2s; min-width: 60px; }
  .btn-opcion:hover:not(:disabled) { border-color: #3b82f6; color: #3b82f6; }
  .feedback-paso { font-size: 0.9rem; font-weight: 600; }
</style>