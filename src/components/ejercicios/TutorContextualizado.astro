---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema de {problema.contexto.objeto}.</p>
    </div>
  </div>

  <!-- LA PIZARRA (Se actualiza con JS) -->
  <div class="pizarra-viva hidden" id={`pizarra-${problema.id}`}>
    <div class="pizarra-contenido">
      <!-- Aquí se inyectará la cuenta matemática -->
    </div>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pizarra = tutor.querySelector(`#pizarra-${problemaId}`);
      const pizarraContenido = pizarra?.querySelector('.pizarra-contenido');
      
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      function actualizarPizarra(nPaso: number) {
        if (!pizarra || !pizarraContenido) return;
        pizarra.classList.remove('hidden');
        
        // Estructura clásica: Dividendo a la izquierda, línea vertical, Divisor a la derecha.
        // Cociente arriba del divisor.
        if (nPaso === 1) {
          pizarraContenido.innerHTML = `
            <div class="cuadro-division">
              <div class="fila-division">
                <div class="lado-dividendo">
                  <span class="numero">248</span>
                </div>
                <div class="linea-vertical"></div>
                <div class="lado-divisor">
                  <span class="numero">4</span>
                </div>
              </div>
            </div>
            <p class="pizarra-nota">Vamos a buscar cuántas veces cabe 4 en 24.</p>
          `;
        } else if (nPaso === 2) {
          pizarraContenido.innerHTML = `
            <div class="cuadro-division">
              <div class="fila-division">
                <div class="lado-dividendo">
                  <span class="numero">248</span>
                  <div class="resta">- 24</div>
                  <div class="linea-horizontal"></div>
                </div>
                <div class="linea-vertical"></div>
                <div class="lado-divisor">
                  <span class="numero">4</span>
                </div>
              </div>
            </div>
            <p class="pizarra-nota">6 × 4 = 24. Usamos 24 láminas.</p>
          `;
        } else if (nPaso === 3) {
          pizarraContenido.innerHTML = `
            <div class="cuadro-division">
              <div class="fila-division">
                <div class="lado-dividendo">
                  <span class="numero">248</span>
                  <div class="resta">- 24</div>
                  <div class="linea-horizontal"></div>
                  <div class="resultado">08</div>
                </div>
                <div class="linea-vertical"></div>
                <div class="lado-divisor">
                  <span class="numero">4</span>
                </div>
              </div>
            </div>
            <p class="pizarra-nota">Nos quedan 08 láminas por repartir.</p>
          `;
        } else if (nPaso >= 4) {
          pizarraContenido.innerHTML = `
            <div class="cuadro-division">
              <div class="fila-division">
                <div class="lado-dividendo">
                  <span class="numero">248</span>
                  <div class="resta">- 24</div>
                  <div class="linea-horizontal"></div>
                  <div class="resultado">08</div>
                  <div class="resta">- 08</div>
                  <div class="linea-horizontal"></div>
                  <div class="resultado-final">00</div>
                </div>
                <div class="linea-vertical"></div>
                <div class="lado-divisor">
                  <div class="cociente">62</div>
                  <div class="numero">4</div>
                </div>
              </div>
            </div>
            <p class="pizarra-nota">¡Listo! 248 ÷ 4 = 62.</p>
          `;
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          actualizarPizarra(pasoActual + 1);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', Courier, monospace;
    display: flex;
    justify-content: center;
  }
  .pizarra-viva.hidden { display: none; }

  .pizarra-contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cuadro-division {
    display: inline-block;
  }

  .fila-division {
    display: flex;
    align-items: flex-start;
  }

  .lado-dividendo {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
  }

  .lado-divisor {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
    padding-left: 0.5rem;
  }

  .linea-vertical {
    border-left: 2px solid #1e293b;
    margin: 0 0.5rem;
    min-height: 4rem;
  }

  .linea-horizontal {
    width: 100%;
    border-top: 2px solid #1e293b;
    margin: 0.2rem 0;
  }

  .cociente {
    color: #2563eb; /* Azul para el resultado final */
    border-bottom: 2px solid #1e293b; /* Línea bajo el cociente */
    padding-bottom: 0.2rem;
    margin-bottom: 0.2rem;
    width: 100%;
    text-align: center;
  }

  .resta {
    color: #dc2626;
  }

  .resultado, .resultado-final {
    color: #16a34a;
  }

  .pizarra-nota {
    font-family: sans-serif;
    font-size: 0.85rem;
    color: #92400e;
    margin-top: 1rem;
    text-align: center;
  }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }
  .paso-item.hidden { display: none; }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .btn-opcion:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .feedback-paso.hidden { display: none; }
</style>