---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;

// Algoritmo dinámico para calcular los pasos de la división
const cifras = String(dividendo).split("").map(Number);
const pasosCalculados: any[] = [];
let parcialActual = 0;
let posicion = 0;
let primeraColumna = true;

while (posicion < cifras.length) {
  let parcial, finColumna;
  
  if (primeraColumna) {
    let valor = cifras[0];
    let tomadas = 1;
    while (valor < divisor && tomadas < cifras.length) {
      valor = valor * 10 + cifras[tomadas];
      tomadas++;
    }
    parcial = valor;
    finColumna = tomadas - 1;
    posicion = tomadas;
    primeraColumna = false;
  } else {
    parcial = parcialActual * 10 + cifras[posicion];
    finColumna = posicion;
    posicion++;
  }

  const digitoCociente = Math.floor(parcial / divisor);
  const producto = digitoCociente * divisor;
  const diferencia = parcial - producto;

  pasosCalculados.push({
    digitoCociente,
    producto,
    diferencia,
    finColumna,
    parcial
  });

  parcialActual = diferencia;
}

const anchoCol = 40;
const xInicio = 40;
const yFila = 50;
const altoFila = 45;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA DINÁMICA (Dibuja todos los pasos, pero ocultos) -->
  <div class="pizarra-viva">
    <svg viewBox="0 0 450 400" class="svg-division">
      
      <!-- Fila 1: El dividendo y el divisor -->
      {cifras.map((cifra, i) => (
        <text x={xInicio + i * anchoCol} y={yFila} class="num">{cifra}</text>
      ))}
      
      <text x={xInicio + cifras.length * anchoCol + 20} y={yFila} class="simbolo">:</text>
      <text x={xInicio + cifras.length * anchoCol + 50} y={yFila} class="num texto-azul">{divisor}</text>

      <text x={xInicio + cifras.length * anchoCol + 80} y={yFila} class="simbolo">=</text>
      
      <!-- Cociente (Se arma dígito a dígito) -->
      {String(cociente).split("").map((dig, i) => (
        <text 
          x={xInicio + cifras.length * anchoCol + 110 + (i * 25)} 
          y={yFila} 
          class="num texto-azul oculto" 
          id={`svg-coc-${i}`}
        >
          {dig}
        </text>
      ))}

      <!-- Pasos de la división (Cada resta y su resultado) -->
      {pasosCalculados.map((paso, index) => {
        const xFin = xInicio + paso.finColumna * anchoCol;
        const yActual = yFila + altoFila * (index * 3 + 1);
        const yLinea = yActual + 10;
        const yRes = yActual + altoFila;

        return (
          <g class="oculto" id={`svg-paso-${index}`}>
            <!-- La resta (Producto) -->
            <text x={xFin - 30} y={yActual} class="simbolo texto-rojo">-</text>
            <text x={xFin} y={yActual} class="num texto-rojo">{paso.producto}</text>
            
            <!-- La línea horizontal -->
            <line x1={xFin - 35} y1={yLinea} x2={xFin + 15} y2={yLinea} class="linea" />
            
            <!-- El resultado (Diferencia) -->
            <text x={xFin} y={yRes} class="num">{paso.diferencia}</text>
          </g>
        );
      })}

      <!-- Si sobra un resto final, se muestra al fondo -->
      {parcialActual > 0 && (
        <g class="oculto" id="svg-resto-final">
          <text x={xInicio + (cifras.length - 1) * anchoCol} y={yFila + altoFila * (pasosCalculados.length * 3 + 1)} class="num texto-verde">
            {parcialActual}
          </text>
        </g>
      )}

    </svg>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item oculto" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso oculto"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      
      // Referencias a los elementos SVG
      const svgPasos = Array.from(tutor.querySelectorAll('[id^="svg-paso-"]')) as SVGElement[];
      const svgCocs = Array.from(tutor.querySelectorAll('[id^="svg-coc-"]')) as SVGElement[];
      const svgRestoFinal = tutor.querySelector('#svg-resto-final') as SVGElement;

      let pasoActual = 0;

      if (pasos.length > 0) pasos[0].classList.remove('oculto');

      function actualizarPizarra(pasoTerminado: number) {
        // La regla es simple: 
        // El paso 1 del tutor revela el primer dígito del cociente.
        // Los pasos pares (2, 4, 6) revelan las restas.
        // Los pasos impares (3, 5, 7) revelan los siguientes dígitos del cociente.
        
        if (pasoTerminado === 1 && svgCocs[0]) {
          svgCocs[0].classList.remove('oculto');
        }
        else if (pasoTerminado === 2 && svgPasos[0]) {
          svgPasos[0].classList.remove('oculto');
        }
        else if (pasoTerminado === 3 && svgCocs[1]) {
          svgCocs[1].classList.remove('oculto');
        }
        else if (pasoTerminado === 4 && svgPasos[1]) {
          svgPasos[1].classList.remove('oculto');
        }
        else if (pasoTerminado === 5 && svgCocs[2]) {
          svgCocs[2].classList.remove('oculto');
        }
        else if (pasoTerminado === 6 && svgPasos[2]) {
          svgPasos[2].classList.remove('oculto');
        }
        else if (pasoTerminado === 6 && svgRestoFinal) {
          svgRestoFinal.classList.remove('oculto');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('oculto');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          actualizarPizarra(pasoActual + 1);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('oculto');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('oculto');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: flex-start;
  }

  .svg-division {
    width: 100%;
    max-width: 450px;
    height: auto;
    font-family: 'Courier New', Courier, monospace;
    font-size: 24px;
    font-weight: bold;
  }

  .num {
    fill: #1e293b;
    text-anchor: middle;
  }

  .texto-azul { fill: #2563eb; }
  .texto-rojo { fill: #dc2626; }
  .texto-verde { fill: #16a34a; }

  .simbolo {
    fill: #64748b;
    text-anchor: middle;
  }

  .linea {
    stroke: #1e293b;
    stroke-width: 3;
  }

  .oculto { display: none !important; }

  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>