---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

// Datos base para la pizarra (usando el problema de 248 / 4)
const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;

const primerasDosCifras = Math.floor(dividendo / 10);
const primeraResta = Math.floor(primerasDosCifras / divisor) * divisor;
const primerResultado = primerasDosCifras - primeraResta;
const segundaCifra = dividendo % 10;
const numeroBajado = parseInt(`${primerResultado}${segundaCifra}`);
const segundaResta = Math.floor(numeroBajado / divisor) * divisor;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    <div class="pizarra-contenido">
      
      <!-- PASO 1: División inicial de dos cifras -->
      <div class="ecuacion hidden" id={`eq1-${problema.id}`}>
        {primerasDosCifras} : {divisor} = {Math.floor(primerasDosCifras / divisor)}
      </div>

      <!-- PASO 2: Primera resta y resultado -->
      <div class="cuenta-larga hidden" id={`resta1-${problema.id}`}>
        <div class="numero">- {primeraResta}</div>
        <div class="linea"></div>
        <div class="resultado">{String(primerResultado).padStart(2, '0')}</div>
      </div>

      <!-- PASO 3: Bajar el 8 y completar cociente -->
      <div class="ecuacion hidden" id={`eq2-${problema.id}`}>
        {dividendo} : {divisor} = {cociente}
      </div>
      <div class="bajada hidden" id={`bajada-${problema.id}`}>
        {String(primerResultado).padStart(2, '0')}<span class="texto-verde">{segundaCifra}</span>
      </div>

      <!-- PASO 4: Segunda resta -->
      <div class="cuenta-larga hidden" id={`resta2-${problema.id}`}>
        <div class="numero">- {String(segundaResta).padStart(3, '0')}</div>
        <div class="linea"></div>
      </div>

      <!-- PASO 5: Resultado final con resto -->
      <div class="resultado-final hidden" id={`final-${problema.id}`}>
        Resultado: <strong>{cociente}</strong>, resto <strong>{resto}</strong>
      </div>

    </div>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      // Referencias a los bloques de la pizarra
      const eq1 = tutor.querySelector(`#eq1-${problemaId}`);
      const resta1 = tutor.querySelector(`#resta1-${problemaId}`);
      const eq2 = tutor.querySelector(`#eq2-${problemaId}`);
      const bajada = tutor.querySelector(`#bajada-${problemaId}`);
      const resta2 = tutor.querySelector(`#resta2-${problemaId}`);
      const final = tutor.querySelector(`#final-${problemaId}`);

      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      function actualizarPizarra(pasoTerminado: number) {
        if (pasoTerminado === 1) {
          eq1?.classList.remove('hidden');
        }
        else if (pasoTerminado === 2) {
          resta1?.classList.remove('hidden');
        }
        else if (pasoTerminado === 3) {
          eq2?.classList.remove('hidden');
          bajada?.classList.remove('hidden');
        }
        else if (pasoTerminado === 4) {
          resta2?.classList.remove('hidden');
        }
        else if (pasoTerminado === 5) {
          final?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: flex-start;
  }

  .pizarra-contenido {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ecuacion {
    font-size: 1.6rem;
  }

  .cuenta-larga {
    margin-left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: fit-content;
  }

  .numero { color: #dc2626; }
  .linea { border-top: 2px solid #1e293b; width: 100%; margin: 0.1rem 0; }
  .resultado { color: #16a34a; }

  .bajada {
    color: #1e293b;
    margin-left: 0;
    display: flex;
    gap: 0.1rem;
  }

  .texto-verde { color: #16a34a; }

  .resultado-final {
    margin-top: 1rem;
    color: #1e293b;
    font-size: 1.2rem;
  }

  .hidden { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>