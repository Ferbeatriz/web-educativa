---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    
    <table class="tabla-division">
      <colgroup>
        <col style="width: 25px">  <!-- signo -->
        <col style="width: 25px">  <!-- decena -->
        <col style="width: 25px">  <!-- unidad -->
        <col style="width: 20px">  <!-- símbolo -->
        <col style="width: 40px">  <!-- cociente -->
      </colgroup>
      <tbody>
        <!-- Fila 0: dividendo y divisor -->
        <tr>
          <td class="col-signo"></td>
          <td class="col-num">2</td>
          <td class="col-num">4</td>
          <td class="col-simbolo">:</td>
          <td class="col-cociente texto-azul">{divisor}</td>
        </tr>

        <!-- Fila 1: primera resta (- 24) -->
        <tr class="hidden" id={`fila-resta1-${problema.id}`}>
          <td class="col-signo texto-rojo">-</td>
          <td class="col-num texto-rojo">2</td>
          <td class="col-num texto-rojo">4</td>
          <td></td>
          <td class="col-cociente texto-azul" id={`coc-1-${problema.id}`}></td>
        </tr>

        <!-- Línea 1 (sin colspan) -->
        <tr class="hidden" id={`linea1-${problema.id}`}>
          <td></td>
          <td class="linea-celda"></td>
          <td class="linea-celda"></td>
          <td></td>
          <td></td>
        </tr>

        <!-- Fila 2: resultado 00 -->
        <tr class="hidden" id={`fila-res1-${problema.id}`}>
          <td></td>
          <td class="col-num">0</td>
          <td class="col-num">0</td>
          <td></td>
          <td></td>
        </tr>

        <!-- Fila 3: bajar el 8 (008) -->
        <tr class="hidden" id={`fila-bajada-${problema.id}`}>
          <td></td>
          <td class="col-num">0</td>
          <td class="col-num">8</td>
          <td></td>
          <td></td>
        </tr>

        <!-- Fila 4: segunda resta (- 8) -->
        <tr class="hidden" id={`fila-resta2-${problema.id}`}>
          <td class="col-signo texto-rojo">-</td>
          <td class="col-num"></td>
          <td class="col-num texto-rojo">8</td>
          <td></td>
          <td class="col-cociente texto-azul" id={`coc-2-${problema.id}`}></td>
        </tr>

        <!-- Línea 2 -->
        <tr class="hidden" id={`linea2-${problema.id}`}>
          <td></td>
          <td></td>
          <td class="linea-celda"></td>
          <td></td>
          <td></td>
        </tr>

        <!-- Fila 5: resultado final (0) -->
        <tr class="hidden" id={`fila-res2-${problema.id}`}>
          <td></td>
          <td></td>
          <td class="col-num">0</td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      const coc1 = tutor.querySelector(`#coc-1-${problemaId}`);
      const coc2 = tutor.querySelector(`#coc-2-${problemaId}`);
      
      const filaResta1 = tutor.querySelector(`#fila-resta1-${problemaId}`);
      const linea1 = tutor.querySelector(`#linea1-${problemaId}`);
      const filaRes1 = tutor.querySelector(`#fila-res1-${problemaId}`);
      
      const filaBajada = tutor.querySelector(`#fila-bajada-${problemaId}`);
      
      const filaResta2 = tutor.querySelector(`#fila-resta2-${problemaId}`);
      const linea2 = tutor.querySelector(`#linea2-${problemaId}`);
      const filaRes2 = tutor.querySelector(`#fila-res2-${problemaId}`);

      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      function actualizarPizarra(pasoTerminado: number) {
        if (pasoTerminado === 1) {
          if (coc1) coc1.textContent = '6';
        }
        else if (pasoTerminado === 2) {
          filaResta1?.classList.remove('hidden');
          linea1?.classList.remove('hidden');
        }
        else if (pasoTerminado === 3) {
          filaRes1?.classList.remove('hidden');
          filaBajada?.classList.remove('hidden');
        }
        else if (pasoTerminado === 4) {
          if (coc2) coc2.textContent = '2';
        }
        else if (pasoTerminado === 5) {
          filaResta2?.classList.remove('hidden');
          linea2?.classList.remove('hidden');
        }
        else if (pasoTerminado === 6) {
          filaRes2?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  /* Tabla de la división */
  .tabla-division {
    border-collapse: collapse;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
  }

  .tabla-division td {
    padding: 0.1rem 0;
    height: 2rem;
    vertical-align: bottom;
  }

  /* Columnas */
  .col-signo {
    text-align: right;
    padding-right: 4px;
  }

  .col-num {
    text-align: right;
  }

  .col-simbolo {
    text-align: center;
  }

  .col-cociente {
    text-align: left;
    padding-left: 4px;
  }

  .texto-azul {
    color: #2563eb;
  }

  .texto-rojo {
    color: #dc2626;
  }

  /* Línea de la resta */
  .linea-celda {
    border-bottom: 2px solid #1e293b;
    height: 0;
    padding: 0 !important;
  }

  .hidden { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>