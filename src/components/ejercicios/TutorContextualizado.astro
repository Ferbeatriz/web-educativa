---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

// Obtenemos los valores iniciales para armar la pizarra estática
const dividendo = problema.dividendo;
const divisor = problema.divisor;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;

// Calculamos las partes de la división larga para mostrarlas paso a paso
// (Asumimos que es una división de 3 cifras entre 1 cifra como 248 ÷ 4)
const primerasDosCifras = Math.floor(dividendo / 10);
const primeraResta = Math.floor(primerasDosCifras / divisor) * divisor;
const primerResultado = primerasDosCifras - primeraResta;
const segundaCifra = dividendo % 10;
const numeroBajado = parseInt(`${primerResultado}${segundaCifra}`);
const segundaResta = Math.floor(numeroBajado / divisor) * divisor;
---

<div class="tutor-wrapper" data-problema={problema.id} data-divisor={divisor}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA (Siempre visible) -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    <div class="pizarra-contenido">
      
      <!-- Estructura clásica de la división -->
      <div class="division-layout">
        
        <!-- Lado izquierdo: La cuenta (Dividendo, restas) -->
        <div class="lado-izquierdo">
          <div class="dividendo" id={`dividendo-${problema.id}`}>
            {dividendo}
          </div>
          
          <!-- Resta 1 (Aparece en paso 2) -->
          <div class="fila-resta hidden" id={`resta1-${problema.id}`}>
            <span class="simbolo-resta">-</span>
            <span class="valor-resta">{primeraResta}</span>
          </div>
          <div class="linea-division hidden" id={`linea1-${problema.id}`}></div>
          <div class="fila-resultado hidden" id={`resultado1-${problema.id}`}>
            {primerResultado}
          </div>

          <!-- Bajada de la siguiente cifra (Aparece en paso 3) -->
          <div class="fila-bajada hidden" id={`bajada-${problema.id}`}>
            {numeroBajado}
          </div>

          <!-- Resta 2 (Aparece en paso 4) -->
          <div class="fila-resta hidden" id={`resta2-${problema.id}`}>
            <span class="simbolo-resta">-</span>
            <span class="valor-resta">{segundaResta}</span>
          </div>
          <div class="linea-division hidden" id={`linea2-${problema.id}`}></div>
          <div class="fila-resultado final hidden" id={`resultado2-${problema.id}`}>
            {resto}
          </div>
        </div>

        <!-- Línea vertical separadora -->
        <div class="linea-vertical"></div>

        <!-- Lado derecho: Divisor y Cociente -->
        <div class="lado-derecho">
          <div class="cociente hidden" id={`cociente-${problema.id}`}>
            {cociente}
          </div>
          <div class="divisor">
            {divisor}
          </div>
        </div>

      </div>

    </div>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      // Referencias a los elementos de la pizarra
      const cociente = tutor.querySelector(`#cociente-${problemaId}`);
      const resta1 = tutor.querySelector(`#resta1-${problemaId}`);
      const linea1 = tutor.querySelector(`#linea1-${problemaId}`);
      const resultado1 = tutor.querySelector(`#resultado1-${problemaId}`);
      const bajada = tutor.querySelector(`#bajada-${problemaId}`);
      const resta2 = tutor.querySelector(`#resta2-${problemaId}`);
      const linea2 = tutor.querySelector(`#linea2-${problemaId}`);
      const resultado2 = tutor.querySelector(`#resultado2-${problemaId}`);

      // Mostrar el primer paso
      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      function revelarElementoPizarra(nPaso: number) {
        // El paso 1 ya se ve la división inicial (248 | 4)
        // Al acertar el paso 1, se revela la resta (paso 2)
        if (nPaso === 1) {
          cociente?.classList.remove('hidden');
          resta1?.classList.remove('hidden');
          linea1?.classList.remove('hidden');
          resultado1?.classList.remove('hidden');
        }
        // Al acertar el paso 2, se baja el 8 (paso 3)
        else if (nPaso === 2) {
          bajada?.classList.remove('hidden');
        }
        // Al acertar el paso 3, se revela la segunda resta (paso 4)
        else if (nPaso === 3) {
          resta2?.classList.remove('hidden');
          linea2?.classList.remove('hidden');
          resultado2?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          // Actualizar la pizarra
          revelarElementoPizarra(pasoActual + 1);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .pizarra-contenido {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
  }

  .division-layout {
    display: flex;
    align-items: stretch;
  }

  .lado-izquierdo {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 0.5rem;
  }

  .lado-derecho {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 0.5rem;
    border-left: 2px solid #1e293b;
  }

  /* Líneas y alineaciones */
  .linea-division {
    width: 100%;
    border-top: 2px solid #1e293b;
    margin: 0.2rem 0;
  }

  .fila-resta {
    display: flex;
    gap: 0.5rem;
    color: #dc2626;
  }

  .fila-resultado {
    color: #16a34a;
  }

  .fila-resultado.final {
    color: #1e293b;
  }

  .fila-bajada {
    margin-top: 0.2rem;
  }

  .cociente {
    color: #2563eb;
    border-bottom: 2px solid #1e293b;
    padding-bottom: 0.2rem;
    margin-bottom: 0.2rem;
    width: 100%;
    text-align: center;
  }

  .hidden { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>