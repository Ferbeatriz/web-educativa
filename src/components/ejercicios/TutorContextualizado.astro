---
import { marked } from 'marked';

interface Props {
  problema: any;
}

const { problema } = Astro.props;

const divisor = problema.divisor;
const dividendo = problema.dividendo;
const cociente = problema.cociente_esperado;
const resto = problema.resto_esperado;

const d1 = Math.floor(dividendo / 100);
const d2 = Math.floor((dividendo % 100) / 10);
const d3 = dividendo % 10;

const primerasDos = d1 * 10 + d2;
const primeraResta = Math.floor(primerasDos / divisor) * divisor;
const primerResultado = primerasDos - primeraResta;
const segundoDigitoCociente = Math.floor((primerResultado * 10 + d3) / divisor);
const segundaResta = segundoDigitoCociente * divisor;
const restoFinal = (primerResultado * 10 + d3) - segundaResta;
---

<div class="tutor-wrapper" data-problema={problema.id}>
  
  <div class="tutor-header">
    <span class="tutor-icon">🔍</span>
    <div>
      <h3 class="tutor-titulo">Vamos paso a paso</h3>
      <p class="tutor-subtitulo">Resolvamos juntos el problema.</p>
    </div>
  </div>

  <!-- LA PIZARRA -->
  <div class="pizarra-viva" id={`pizarra-${problema.id}`}>
    
    <!-- Ecuación superior -->
    <div class="ecuacion-header">
      <span>{dividendo}</span>
      <span>:</span>
      <span class="texto-azul">{divisor}</span>
      <span>=</span>
      <span class="texto-azul" id={`coc-1-${problema.id}`}></span>
      <span class="texto-azul" id={`coc-2-${problema.id}`}></span>
    </div>

    <!-- Cuenta Larga -->
    <div class="cuenta-larga">
      
      <!-- Fila 1: Primera resta (- 24) -->
      <div class="fila-resta hidden" id={`resta1-${problema.id}`}>
        <span class="simbolo-menos">-</span>
        <span class="numero">{primeraResta}</span>
        <div class="linea-horizontal"></div>
      </div>

      <!-- Fila 2: Resultado 1 (00) -->
      <div class="fila-resultado hidden" id={`res1-${problema.id}`}>
        <span class="numero">{String(primerResultado).padStart(2, '0')}</span>
      </div>

      <!-- Fila 3: Bajar el 8 (008) -->
      <div class="fila-resultado hidden" id={`bajada-${problema.id}`} style="padding-left: 1.2rem;">
        <span class="numero">{String(primerResultado).padStart(2, '0')}{d3}</span>
      </div>

      <!-- Fila 4: Segunda resta (- 8) -->
      <div class="fila-resta hidden" id={`resta2-${problema.id}`} style="padding-left: 1.2rem;">
        <span class="simbolo-menos">-</span>
        <span class="numero">{segundaResta}</span>
        <div class="linea-horizontal"></div>
      </div>

      <!-- Fila 5: Resultado final (00) -->
      <div class="fila-resultado hidden" id={`res2-${problema.id}`} style="padding-left: 1.2rem;">
        <span class="numero">{String(restoFinal).padStart(2, '0')}</span>
      </div>

    </div>
  </div>

  <div class="pasos-container">
    {problema.tutor.pasos.map((paso: any, index: number) => (
      <div class="paso-item hidden" data-paso={paso.n}>
        <div class="paso-badge">Paso {paso.n}</div>
        <p class="paso-pregunta" set:html={marked.parse(paso.pregunta)}></p>
        
        <div class="opciones-grid">
          {paso.opciones.map((opcion: string) => (
            <button
              class="btn-opcion"
              data-opcion={opcion}
              data-correcta={paso.respuesta_correcta === opcion}
            >
              {opcion}
            </button>
          ))}
        </div>

        <div class="feedback-paso hidden"></div>
      </div>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tutores = document.querySelectorAll('.tutor-wrapper');
    
    tutores.forEach((tutor) => {
      const problemaId = tutor.getAttribute('data-problema');
      const pasos = Array.from(tutor.querySelectorAll('.paso-item')) as HTMLElement[];
      let pasoActual = 0;

      const coc1 = tutor.querySelector(`#coc-1-${problemaId}`);
      const coc2 = tutor.querySelector(`#coc-2-${problemaId}`);
      
      const resta1 = tutor.querySelector(`#resta1-${problemaId}`);
      const res1 = tutor.querySelector(`#res1-${problemaId}`);
      const bajada = tutor.querySelector(`#bajada-${problemaId}`);
      const resta2 = tutor.querySelector(`#resta2-${problemaId}`);
      const res2 = tutor.querySelector(`#res2-${problemaId}`);

      if (pasos.length > 0) pasos[0].classList.remove('hidden');

      function actualizarPizarra(pasoTerminado: number) {
        if (pasoTerminado === 1) {
          coc1?.classList.remove('hidden');
          if (coc1) coc1.textContent = '6';
        }
        else if (pasoTerminado === 2) {
          resta1?.classList.remove('hidden');
          res1?.classList.remove('hidden');
        }
        else if (pasoTerminado === 3) {
          bajada?.classList.remove('hidden');
        }
        else if (pasoTerminado === 4) {
          coc2?.classList.remove('hidden');
          if (coc2) coc2.textContent = '2';
          resta2?.classList.remove('hidden');
          res2?.classList.remove('hidden');
        }
      }

      tutor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains('btn-opcion')) return;

        const pasoElement = target.closest('.paso-item') as HTMLElement;
        const feedbackElement = pasoElement.querySelector('.feedback-paso') as HTMLElement;
        const esCorrecta = target.getAttribute('data-correcta') === 'true';

        pasoElement.querySelectorAll('.btn-opcion').forEach(b => {
          b.classList.remove('bg-green-100', 'border-green-500', 'bg-red-100', 'border-red-500');
        });

        if (esCorrecta) {
          target.classList.add('bg-green-100', 'border-green-500');
          feedbackElement.className = 'feedback-paso text-green-700 bg-green-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '✅ ¡Muy bien!';
          feedbackElement.classList.remove('hidden');

          pasoElement.querySelectorAll('.btn-opcion').forEach((b: any) => b.disabled = true);

          const pasoTerminado = pasoActual + 1;
          actualizarPizarra(pasoTerminado);

          setTimeout(() => {
            pasoActual++;
            if (pasoActual < pasos.length) {
              pasos[pasoActual].classList.remove('hidden');
              pasos[pasoActual].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }, 1500);

        } else {
          target.classList.add('bg-red-100', 'border-red-500');
          feedbackElement.className = 'feedback-paso text-red-700 bg-red-50 p-3 rounded-lg mt-3';
          feedbackElement.innerHTML = '❌ Casi. Intenta de nuevo.';
          feedbackElement.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .tutor-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .tutor-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tutor-icon { font-size: 1.5rem; }
  .tutor-titulo { font-size: 1.1rem; font-weight: 700; color: #334155; margin: 0; }
  .tutor-subtitulo { font-size: 0.9rem; color: #64748b; font-style: italic; margin: 0; }

  /* ESTILOS DE LA PIZARRA */
  .pizarra-viva {
    background: #fffbeb;
    border: 2px dashed #fcd34d;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ecuacion-header {
    font-family: 'Courier New', Courier, monospace;
    font-size: 2rem;
    font-weight: bold;
    color: #1e293b;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }

  .texto-azul { color: #2563eb; }

  /* La cuenta se apila verticalmente */
  .cuenta-larga {
    display: flex;
    flex-direction: column;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e293b;
    margin-left: 0.5rem;
  }

  /* Cada fila es un bloque que se empuja a la derecha */
  .fila-resta {
    display: flex;
    align-items: flex-end;
    margin-top: 0.2rem;
    position: relative;
  }

  .fila-resultado {
    display: flex;
    align-items: flex-end;
    margin-top: 0.2rem;
  }

  .simbolo-menos {
    color: #dc2626;
    margin-right: 0.2rem;
  }

  .numero {
    letter-spacing: 0.1em; /* Separa ligeramente los dígitos para que se lean bien */
  }

  .linea-horizontal {
    position: absolute;
    bottom: -2px;
    left: -1rem; /* La línea se extiende un poco a la izquierda */
    right: 0;
    border-bottom: 3px solid #1e293b;
  }

  .hidden { display: none !important; }

  /* ESTILOS DE LOS PASOS */
  .paso-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .paso-badge {
    display: inline-block;
    background: #3b82f6;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .paso-pregunta {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .opciones-grid {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-opcion {
    background: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 60px;
  }

  .btn-opcion:hover:not(:disabled) {
    border-color: #3b82f6;
    color: #3b82f6;
  }

  .feedback-paso {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>