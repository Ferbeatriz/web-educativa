---
/**
 * Componente de tutor interactivo por pasos.
 * El estudiante avanza haciendo clic en opciones.
 * Sin voz. Solo clic/touch.
 */
import type { Ejercicio } from '../../lib/tutor/validador';

interface Props {
  ejercicio: Ejercicio;
  color?: string;
}

const { ejercicio, color = '#3B82F6' } = Astro.props;
const primerPaso = ejercicio.pasos[0];
---

<div
  id="tutor-container"
  class="max-w-2xl mx-auto"
  data-ejercicio-id={ejercicio.id}
  data-total-pasos={ejercicio.pasos.length}
>
  <script
    id="tutor-data"
    type="application/json"
    set:html={JSON.stringify(ejercicio)}
  />

  {ejercicio.contexto && (
    <div
      class="rounded-3xl p-5 mb-6 border-l-4"
      style={`background: #EFF6FF; border-color: ${color};`}
    >
      <p class="text-sm font-bold uppercase tracking-wide mb-1" style={`color: ${color};`}>
        Situación
      </p>
      <p class="text-gray-700 leading-relaxed">{ejercicio.contexto}</p>
    </div>
  )}

  <!-- Barra de progreso -->
  <div class="mb-6">
    <div class="flex justify-between items-center mb-2">
      <span id="tutor-paso-label" class="text-sm font-bold text-gray-500">
        Paso 1 de {ejercicio.pasos.length}
      </span>
    </div>
    <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
      <div
        id="tutor-barra"
        class="h-full rounded-full transition-all duration-500"
        style={`width: 0%; background: ${color};`}
      ></div>
    </div>
  </div>

  <!-- Tarjeta del paso actual -->
  <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100">
    <p id="tutor-pregunta" class="text-lg md:text-xl font-bold text-gray-800 mb-6 leading-snug">
      {primerPaso.pregunta}
    </p>

    <div id="tutor-opciones" class="grid grid-cols-2 gap-3">
      {primerPaso.opciones.map((op) => (
        <button
          type="button"
          class="tutor-opcion px-4 py-4 rounded-2xl border-2 border-gray-200 bg-white font-bold text-gray-700 hover:border-gray-300 transition-all cursor-pointer"
          data-respuesta={op}
        >
          {op}
        </button>
      ))}
    </div>

    <div id="tutor-feedback" class="hidden mt-5 rounded-2xl p-4 text-sm leading-relaxed"></div>

    <div id="tutor-visual-wrap" class="hidden"></div>

    <div id="tutor-continuar-wrap" class="hidden mt-5 text-center">
      <button
        id="tutor-continuar"
        type="button"
        class="inline-flex items-center gap-2 px-6 py-3 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition-all cursor-pointer"
        style={`background: ${color};`}
      >
        Continuar →
      </button>
    </div>
  </div>

  <div id="tutor-cierre" class="hidden mt-6 bg-green-50 border-2 border-green-200 rounded-3xl p-6 text-center">
    <div class="text-5xl mb-3">🎉</div>
    <h3 class="text-xl font-extrabold text-green-800 mb-2">¡Ejercicio completado!</h3>
    <p id="tutor-cierre-texto" class="text-green-700 leading-relaxed"></p>
  </div>
</div>

<script>
  import { validarPaso, type Ejercicio, type ResultadoValidacion, type Visual, type EscenarioGrupos, type EscenarioResto } from '../../lib/tutor/validador';

  const container = document.getElementById('tutor-container');
  const dataEl = document.getElementById('tutor-data');
  if (container && dataEl) {
    const ejercicio: Ejercicio = JSON.parse(dataEl.textContent || '{}');

    const pasoLabel = document.getElementById('tutor-paso-label')!;
    const barra = document.getElementById('tutor-barra')!;
    const pregunta = document.getElementById('tutor-pregunta')!;
    const opciones = document.getElementById('tutor-opciones')!;
    const feedback = document.getElementById('tutor-feedback')!;
    const visualWrap = document.getElementById('tutor-visual-wrap')!;
    const continuarWrap = document.getElementById('tutor-continuar-wrap')!;
    const btnContinuar = document.getElementById('tutor-continuar') as HTMLButtonElement;
    const cierre = document.getElementById('tutor-cierre')!;
    const cierreTexto = document.getElementById('tutor-cierre-texto')!;

    let pasoActual = 1;
    let acerto = false;

    const COLORES = {
      falta:     { bg: '#FEF3C7', border: '#F59E0B', text: '#92400E' },
      correcto:  { bg: '#D1FAE5', border: '#10B981', text: '#065F46' },
      sobra:     { bg: '#FFEDD5', border: '#F97316', text: '#9A3412' },
      imposible: { bg: '#FEE2E2', border: '#DC2626', text: '#991B1B' },
    } as const;

    function renderVisual(v: Visual, esc: EscenarioGrupos | EscenarioResto) {
      visualWrap.innerHTML = '';

      if (v.tipo === 'grupos' && 'grupos' in esc) {
        const e = esc as EscenarioGrupos;
        const c = COLORES[e.estado];
        const etiqueta = v.etiqueta_grupo || 'grupo';
        const cajasRestantes = e.estado === 'sobra' ? Math.ceil((e.resultado - v.total) / e.por_grupo) : 0;

        const wrapper = document.createElement('div');
        wrapper.className = 'mt-5 rounded-2xl border-2 p-4 md:p-5';
        wrapper.style.background = '#F9FAFB';
        wrapper.style.borderColor = '#E5E7EB';

        let html = `<p class="text-xs font-extrabold uppercase tracking-wide text-gray-500 mb-3">Así se ve</p>`;
        html += `<div class="flex items-center gap-2 mb-4 flex-wrap">
          <span class="text-sm font-bold text-gray-600">Tenemos:</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: #DBEAFE; color: #1D4ED8;">${v.total} en total</span>
        </div>`;

        html += `<div class="flex flex-wrap gap-2 mb-4">`;
        for (let i = 0; i < e.grupos; i++) {
          const esSobrante = e.estado === 'sobra' && i >= (e.grupos - cajasRestantes);
          const cc = esSobrante ? COLORES.sobra : c;
          html += `<div class="flex flex-col items-center justify-center rounded-xl font-extrabold text-sm border-2 px-2" style="background: ${cc.bg}; border-color: ${cc.border}; color: ${cc.text}; min-width: 44px; min-height: 44px;">${e.por_grupo}</div>`;
        }
        html += `</div>`;

        html += `<div class="flex items-center gap-2 mb-3 flex-wrap">
          <span class="text-sm font-bold text-gray-600">Resultado:</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: ${c.bg}; color: ${c.text};">${e.grupos} × ${e.por_grupo} = ${e.resultado}</span>
        </div>`;

        if (e.estado === 'falta') {
          html += `<p class="text-sm leading-relaxed" style="color: ${c.text};">Con <strong>${e.grupos}</strong> ${etiqueta}s solo llegamos a <strong>${e.resultado}</strong>. Todavía falta para ${v.total}. Prueba con más.</p>`;
        } else if (e.estado === 'correcto') {
          const sobra = v.total - e.resultado;
          html += `<p class="text-sm leading-relaxed" style="color: ${c.text};">Con <strong>${e.grupos}</strong> ${etiqueta}s llegamos a <strong>${e.resultado}</strong>.${sobra > 0 ? ` Sobran <strong>${sobra}</strong>.` : ''}</p>`;
        } else if (e.estado === 'sobra') {
          const exceso = e.resultado - v.total;
          html += `<p class="text-sm leading-relaxed" style="color: ${c.text};">Con <strong>${e.grupos}</strong> ${etiqueta}s llegamos a <strong>${e.resultado}</strong>, pero solo tenemos <strong>${v.total}</strong>. Nos pasamos por <strong>${exceso}</strong>.</p>`;
        }

        if (e.nota) {
          html += `<p class="text-xs italic mt-2 text-gray-500">${e.nota}</p>`;
        }

        wrapper.innerHTML = html;
        visualWrap.appendChild(wrapper);
      }

      if (v.tipo === 'resto' && 'resto' in esc) {
        const e = esc as EscenarioResto;
        const c = e.estado === 'imposible' ? COLORES.imposible : COLORES.correcto;

        const wrapper = document.createElement('div');
        wrapper.className = 'mt-5 rounded-2xl border-2 p-4 md:p-5';
        wrapper.style.background = '#F9FAFB';
        wrapper.style.borderColor = '#E5E7EB';

        let html = `<p class="text-xs font-extrabold uppercase tracking-wide text-gray-500 mb-3">Así se ve</p>`;

        html += `<div class="flex items-center gap-2 mb-4 flex-wrap">
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: #D1FAE5; color: #065F46;">${v.en_cajas} en las cajas</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: ${c.bg}; color: ${c.text};">${e.resto} sueltos</span>
        </div>`;

        html += `<div class="flex flex-wrap gap-2 mb-3">`;
        for (let i = 0; i < e.resto; i++) {
          html += `<div class="flex items-center justify-center rounded-lg font-extrabold text-sm border-2" style="width: 40px; height: 40px; background: ${c.bg}; border-color: ${c.border}; color: ${c.text};">1</div>`;
        }
        html += `</div>`;

        if (e.resto === 0) {
          html += `<p class="text-sm text-gray-600">No sobra nada.</p>`;
        }

        html += `<p class="text-sm leading-relaxed" style="color: ${c.text};">Total: <strong>${v.en_cajas}</strong> + <strong>${e.resto}</strong> = <strong>${v.en_cajas + e.resto}</strong>${(v.en_cajas + e.resto !== v.total) ? ` · Ojo: el total real es <strong>${v.total}</strong>.` : ''}</p>`;

        if (e.nota) {
          html += `<p class="text-xs italic mt-2 text-gray-500">${e.nota}</p>`;
        }

        wrapper.innerHTML = html;
        visualWrap.appendChild(wrapper);
      }

      visualWrap.classList.remove('hidden');
    }

    function pintarPaso(n: number) {
      const paso = ejercicio.pasos[n - 1];
      pasoLabel.textContent = `Paso ${n} de ${ejercicio.pasos.length}`;
      const pct = ((n - 1) / ejercicio.pasos.length) * 100;
      barra.style.width = `${pct}%`;
      pregunta.textContent = paso.pregunta;

      opciones.innerHTML = '';
      paso.opciones.forEach((op) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tutor-opcion px-4 py-4 rounded-2xl border-2 border-gray-200 bg-white font-bold text-gray-700 hover:border-gray-300 transition-all cursor-pointer';
        btn.dataset.respuesta = op;
        btn.textContent = op;
        btn.addEventListener('click', () => responder(op));
        opciones.appendChild(btn);
      });

      feedback.classList.add('hidden');
      feedback.innerHTML = '';
      visualWrap.classList.add('hidden');
      visualWrap.innerHTML = '';
      continuarWrap.classList.add('hidden');
      acerto = false;
    }

    function responder(respuesta: string) {
      if (acerto) return;
      const r: ResultadoValidacion = validarPaso(ejercicio, pasoActual, respuesta);
      feedback.classList.remove('hidden');

      if (r.correcto) {
        acerto = true;
        feedback.className = 'mt-5 rounded-2xl p-4 text-sm leading-relaxed bg-green-50 text-green-800 border-2 border-green-200';
        feedback.innerHTML = `✅ ${r.feedback}`;

        opciones.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
          b.disabled = true;
          b.classList.add('opacity-60', 'cursor-not-allowed');
          b.classList.remove('cursor-pointer', 'hover:border-gray-300');
        });

        if (r.visual_datos && r.visual_escenario) {
          renderVisual(r.visual_datos, r.visual_escenario);
        }

        if (r.completo) {
          setTimeout(() => {
            cierreTexto.textContent = ejercicio.cierre || 'Terminaste todos los pasos.';
            cierre.classList.remove('hidden');
            barra.style.width = '100%';
            pasoLabel.textContent = `Paso ${ejercicio.pasos.length} de ${ejercicio.pasos.length} · ¡Completo!`;
          }, 400);
        } else {
          continuarWrap.classList.remove('hidden');
        }
      } else {
        feedback.className = 'mt-5 rounded-2xl p-4 text-sm leading-relaxed bg-orange-50 text-orange-800 border-2 border-orange-200';
        feedback.innerHTML = `💡 ${r.feedback}`;

        if (r.visual_datos && r.visual_escenario) {
          renderVisual(r.visual_datos, r.visual_escenario);
        }
      }
    }

    btnContinuar.addEventListener('click', () => {
      pasoActual += 1;
      pintarPaso(pasoActual);
    });

    pintarPaso(1);
  }
</script>
