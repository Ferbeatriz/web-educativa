---
/**
 * Web Component de animación demostrativa para resta con reserva.
 * Muestra el préstamo (5 → 4, 2 → 12) y la resta paso a paso.
 */
---

<animacion-resta></animacion-resta>

<script>
  const COLORES = {
    correcto: { bg: '#D1FAE5', border: '#10B981', text: '#065F46', bloque: '#34D399' },
    error:    { bg: '#FFEDD5', border: '#F97316', text: '#9A3412', bloque: '#FB923C' },
  } as const;

  class AnimacionResta extends HTMLElement {
    private escenarioActual: any = null;
    private visualActual: any = null;

    connectedCallback() {
      this.style.display = 'block';
    }

    render(visual: any, escenario: any) {
      this.visualActual = visual;
      this.escenarioActual = escenario;
      this.innerHTML = '';

      if (!visual || !escenario) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'mt-5 rounded-2xl border-2 p-4 md:p-5';
      wrapper.style.background = '#F9FAFB';
      wrapper.style.borderColor = '#E5E7EB';

      this.renderResta(wrapper, visual, escenario);

      this.appendChild(wrapper);
      this.conectarRepetir();
    }

    private renderResta(wrapper: HTMLElement, visual: any, escenario: any) {
      const e = escenario;
      const c = COLORES[e.estado as keyof typeof COLORES];
      const emoji = visual.emoji_bloque || '🔢';

      // Cabecera
      const header = document.createElement('div');
      header.className = 'flex items-center justify-between mb-3 flex-wrap gap-2';
      header.innerHTML = `
        <p class="text-xs font-extrabold uppercase tracking-wide text-gray-500">Así se resta</p>
        <button type="button" class="btn-repetir text-xs font-bold text-gray-500 hover:text-gray-800 underline cursor-pointer">↻ Repetir</button>
      `;
      wrapper.appendChild(header);

      // Cuenta vertical (minuendo - sustraendo)
      const cuenta = document.createElement('div');
      cuenta.className = 'flex justify-center mb-4';
      cuenta.innerHTML = `
        <div class="font-mono text-4xl leading-tight" style="color: ${c.text};">
          <div class="text-right tracking-widest">${this.formatearNumero(visual.minuendo, e.prestamo)}</div>
          <div class="text-right tracking-widest border-b-2 border-gray-400 pb-1">− ${visual.sustraendo}</div>
          <div class="text-right tracking-widest pt-1 font-extrabold" style="color: ${c.text};">
            ${e.estado === 'correcto' ? e.resultado : '?'}
          </div>
        </div>
      `;
      wrapper.appendChild(cuenta);

      // Explicación del préstamo
      if (e.prestamo) {
        const prestamoBox = document.createElement('div');
        prestamoBox.className = 'mb-3 p-3 rounded-xl text-sm';
        prestamoBox.style.background = COLORES.correcto.bg;
        prestamoBox.style.color = COLORES.correcto.text;
        prestamoBox.innerHTML = `
          <strong>Préstamo:</strong> la decena ${e.prestamo.desde} se convierte en ${e.prestamo.nuevo_desde}, 
          y la unidad ${e.prestamo.hacia} se convierte en ${e.prestamo.nuevo_hacia}.
        `;
        wrapper.appendChild(prestamoBox);
      }

      // Parciales
      if (e.parcial) {
        const parcialBox = document.createElement('div');
        parcialBox.className = 'flex items-center gap-2 mb-3 flex-wrap';
        let html = '<span class="text-sm font-bold text-gray-600">Resultado parcial:</span>';
        if (e.parcial.unidades !== null) {
          html += `<span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: ${COLORES.correcto.bg}; color: ${COLORES.correcto.text};">unidades: ${e.parcial.unidades}</span>`;
        }
        if (e.parcial.decenas !== null) {
          html += `<span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: ${COLORES.correcto.bg}; color: ${COLORES.correcto.text};">decenas: ${e.parcial.decenas}</span>`;
        }
        parcialBox.innerHTML = html;
        wrapper.appendChild(parcialBox);
      }

      // Resultado final
      if (e.estado === 'correcto') {
        const res = document.createElement('div');
        res.className = 'flex items-center gap-2 mb-3 flex-wrap';
        res.innerHTML = `
          <span class="text-sm font-bold text-gray-600">Resultado:</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-extrabold" style="background: ${c.bg}; color: ${c.text};">
            ${e.minuendo} − ${e.sustraendo} = ${e.resultado}
          </span>
        `;
        wrapper.appendChild(res);
      }

      // Mensaje
      const msg = document.createElement('p');
      msg.className = 'text-sm leading-relaxed';
      msg.style.color = c.text;
      if (e.estado === 'correcto') {
        msg.innerHTML = `Con el préstamo, la resta queda: <strong>12 − 7 = 5</strong> y <strong>4 − 2 = 2</strong>. Resultado final: <strong>${e.resultado}</strong>.`;
      } else {
        msg.innerHTML = `Todavía no llegamos al resultado correcto. Revisa el préstamo.`;
      }
      wrapper.appendChild(msg);

      if (e.nota) {
        const nota = document.createElement('p');
        nota.className = 'text-xs italic mt-2 text-gray-500';
        nota.textContent = e.nota;
        wrapper.appendChild(nota);
      }
    }

    private formatearNumero(n: number, prestamo: any): string {
      // Si hay préstamo, mostramos el número con el tachado
      if (prestamo && prestamo.desde === 5 && prestamo.nuevo_desde === 4) {
        return `<span style="text-decoration: line-through; opacity: 0.5;">5</span><span style="color: #10B981;">4</span>2`;
      }
      return String(n);
    }

    private conectarRepetir() {
      const btn = this.querySelector<HTMLButtonElement>('.btn-repetir');
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (this.visualActual && this.escenarioActual) {
          this.render(this.visualActual, this.escenarioActual);
        }
      });
    }
  }

  if (!customElements.get('animacion-resta')) {
    customElements.define('animacion-resta', AnimacionResta);
  }
</script>