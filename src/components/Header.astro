---
// Header global de la web
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 py-3 md:py-4 flex items-center justify-between">

    <!-- Logo + nombre -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-9 h-9 md:w-10 md:h-10 rounded-full bg-brand-500 flex items-center justify-center text-lg md:text-xl shadow-sm group-hover:scale-105 transition-transform">
        🦊
      </div>
      <span class="font-extrabold text-gray-800 text-base md:text-lg tracking-tight">
        Aprende Jugando
      </span>
    </a>

    <!-- Acciones derecha -->
    <nav class="flex items-center gap-2">
      <a
        href="/"
        class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold text-gray-600 hover:text-brand-600 hover:bg-brand-50 transition-colors"
      >
        🏠 Inicio
      </a>

      <!-- Zona dinámica: cambia según si hay sesión -->
      <div id="header-auth-zone" class="flex items-center gap-2">
        <!-- Contenido por defecto (sin sesión) -->
        <a
          href="/login"
          id="header-login-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold text-white bg-gradient-to-br from-brand-500 to-brand-600 hover:shadow-md transition-shadow"
        >
          👤 Iniciar sesión
        </a>
      </div>
    </nav>

  </div>
</header>

<script>
  import { getAlumna, logout } from '../lib/auth';

  function renderizarHeader() {
    const zona = document.getElementById('header-auth-zone');
    if (!zona) return;

    const alumna = getAlumna();

    if (alumna) {
      // Hay sesión: mostrar nombre + botón salir
      const primerNombre = alumna.nombre.split(' ')[0];
      zona.innerHTML = `
        <span class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold text-brand-600 bg-brand-50">
          ⭐ ${primerNombre}
        </span>
        <button
          id="header-logout-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold text-gray-600 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
        >
          Salir
        </button>
      `;

      document.getElementById('header-logout-btn')?.addEventListener('click', async () => {
        await logout();
        window.location.href = '/login';
      });
    } else {
      // Sin sesión: mostrar botón login
      zona.innerHTML = `
        <a
          href="/login"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-bold text-white bg-gradient-to-br from-brand-500 to-brand-600 hover:shadow-md transition-shadow"
        >
          👤 Iniciar sesión
        </a>
      `;
    }
  }

  // Renderizar al cargar
  renderizarHeader();

  // Re-renderizar si cambia el localStorage en otra pestaña
  window.addEventListener('storage', (e) => {
    if (e.key === 'web_educativa_alumna' || e.key === 'web_educativa_token') {
      renderizarHeader();
    }
  });
</script>
