---
interface Pregunta {
  pregunta: string;
  opciones: string[];
  respuesta_correcta: number;
  explicacion: string;
}

interface Props {
  trivia: Pregunta[];
}

const { trivia } = Astro.props;
---

<div id="trivia-container" class="space-y-6">
  {trivia.map((p, idx) => (
    <div
      class="trivia-pregunta bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-gray-100"
      data-pregunta-index={idx}
      data-respuesta-correcta={p.respuesta_correcta}
    >
      <!-- Número y pregunta -->
      <div class="flex items-start gap-3 mb-4">
        <span class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-500 text-white font-extrabold flex items-center justify-center text-sm">
          {idx + 1}
        </span>
        <h3 class="text-lg md:text-xl font-extrabold text-gray-800 leading-tight">
          {p.pregunta}
        </h3>
      </div>

      <!-- Opciones -->
      <div class="grid grid-cols-1 gap-3 mb-4">
        {p.opciones.map((opcion, opIdx) => (
          <button
            class="opcion-btn text-left w-full px-5 py-4 rounded-2xl border-2 border-gray-100 bg-gray-50 hover:border-brand-300 hover:bg-brand-50 transition-all duration-200 font-bold text-gray-700"
            data-opcion-index={opIdx}
          >
            <span class="inline-block w-6 h-6 rounded-full bg-white text-center text-xs font-extrabold leading-6 mr-3 text-gray-500">
              {String.fromCharCode(65 + opIdx)}
            </span>
            {opcion}
          </button>
        ))}
      </div>

      <!-- Explicación (oculta hasta responder) -->
      <div
        class="explicacion hidden rounded-2xl p-4 text-sm font-bold"
        data-explicacion={p.explicacion}
      >
        {p.explicacion}
      </div>
    </div>
  ))}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const preguntas = document.querySelectorAll('.trivia-pregunta');

    preguntas.forEach((preguntaEl) => {
      const botones = preguntaEl.querySelectorAll('.opcion-btn') as NodeListOf<HTMLButtonElement>;
      const explicacionEl = preguntaEl.querySelector('.explicacion') as HTMLElement;
      const respuestaCorrecta = parseInt(preguntaEl.getAttribute('data-respuesta-correcta') || '0');
      let yaRespondida = false;

      botones.forEach((boton) => {
        boton.addEventListener('click', () => {
          if (yaRespondida) return;
          yaRespondida = true;

          const opcionElegida = parseInt(boton.getAttribute('data-opcion-index') || '0');
          const esCorrecta = opcionElegida === respuestaCorrecta;

          // Deshabilitar todos los botones
          botones.forEach((b) => {
            b.disabled = true;
            b.classList.add('cursor-not-allowed');
          });

          if (esCorrecta) {
            boton.classList.remove('border-gray-100', 'bg-gray-50', 'border-brand-300', 'bg-brand-50');
            boton.classList.add('!border-success-500', '!bg-success-500/10', '!text-success-600');
          } else {
            boton.classList.remove('border-gray-100', 'bg-gray-50', 'border-brand-300', 'bg-brand-50');
            boton.classList.add('!border-coral-500', '!bg-coral-500/10', '!text-coral-600');

            const botonCorrecto = botones[respuestaCorrecta];
            botonCorrecto.classList.remove('border-gray-100', 'bg-gray-50', 'border-brand-300', 'bg-brand-50');
            botonCorrecto.classList.add('!border-success-500', '!bg-success-500/10', '!text-success-600');
          }

          // Mostrar explicación
          explicacionEl.classList.remove('hidden');
          if (esCorrecta) {
            explicacionEl.classList.add('bg-success-500/10', 'text-success-600', 'border', 'border-success-500/30');
          } else {
            explicacionEl.classList.add('bg-coral-500/10', 'text-coral-600', 'border', 'border-coral-500/30');
          }
        });
      });
    });
  });
</script>
