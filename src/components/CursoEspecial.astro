---
interface Capitulo {
  id: string;
  numero: number;
  numero_romano: string;
  titulo: string;
  subtitulo: string;
  emoji: string;
  activo: boolean;
}

interface Props {
  curso: {
    id: string;
    titulo: string;
    subtitulo: string;
    descripcion: string;
    emoji: string;
    fuente: string;
    progreso_puntos_por_capitulo: number;
    total_capitulos: number;
    capitulos: Capitulo[];
  };
  materiaId: string;
}

const { curso, materiaId } = Astro.props;
const capitulosActivos = curso.capitulos.filter((c) => c.activo);
const capitulosPendientes = curso.capitulos.filter((c) => !c.activo);

// Colores HEX directos por materia (y por curso si sobrescribe)
const colores: Record<string, { c50: string; c100: string; c200: string; c400: string; c500: string; c600: string; c700: string }> = {
  lenguaje:     { c50: '#FDF2F8', c100: '#FCE7F3', c200: '#FBCFE8', c400: '#F472B6', c500: '#EC4899', c600: '#DB2777', c700: '#BE185D' },
  matematicas:  { c50: '#EFF6FF', c100: '#DBEAFE', c200: '#BFDBFE', c400: '#60A5FA', c500: '#3B82F6', c600: '#2563EB', c700: '#1D4ED8' },
  historia:     { c50: '#FFFBEB', c100: '#FEF3C7', c200: '#FDE68A', c400: '#FBBF24', c500: '#F59E0B', c600: '#D97706', c700: '#B45309' },
  ingles:       { c50: '#F0FDFA', c100: '#CCFBF1', c200: '#99F6E4', c400: '#2DD4BF', c500: '#14B8A6', c600: '#0D9488', c700: '#0F766E' },
  ciencias:     { c50: '#F7FEE7', c100: '#ECFCCB', c200: '#D9F99D', c400: '#A3E635', c500: '#84CC16', c600: '#65A30D', c700: '#4D7C0F' },
  programacion: { c50: '#FDF4FF', c100: '#FAE8FF', c200: '#F5D0FE', c400: '#E879F9', c500: '#D946EF', c600: '#C026D3', c700: '#A21CAF' },
  selknam:      { c50: '#FEF2F2', c100: '#FEE2E2', c200: '#FECACA', c400: '#F87171', c500: '#DC2626', c600: '#B91C1C', c700: '#991B1B' },
  brand:        { c50: '#F5F3FF', c100: '#EDE9FE', c200: '#DDD6FE', c400: '#A78BFA', c500: '#8B5CF6', c600: '#7C3AED', c700: '#6D28D9' },
};

// Si el curso define un color propio, ese gana. Si no, usa el de la materia.
const colorFinal = (curso as any).color || materiaId;
const c = colores[colorFinal] || colores.brand;
};

const c = colores[materiaId] || colores.brand;

const estiloPortada = `background: linear-gradient(135deg, ${c.c500} 0%, ${c.c600} 50%, ${c.c700} 100%);`;
const estiloNumero = `background: linear-gradient(135deg, ${c.c400} 0%, ${c.c600} 100%);`;
---

<div class="space-y-6">

  <!-- 🎭 PORTADA DEL CURSO -->
  <div class="rounded-3xl p-6 md:p-10 shadow-xl text-white relative overflow-hidden" style={estiloPortada}>
    <div class="absolute top-0 right-0 text-[180px] leading-none opacity-10 select-none pointer-events-none">
      {curso.emoji}
    </div>

    <div class="relative z-10">
      <span class="inline-block text-xs font-extrabold px-3 py-1 rounded-full bg-white/20 backdrop-blur mb-4 tracking-wide uppercase">
        ✨ Serie Especial
      </span>

      <h1 class="text-3xl md:text-5xl font-extrabold mb-2 leading-tight">
        {curso.titulo}
      </h1>
      <p class="text-lg md:text-xl font-bold text-white/90 mb-5">
        {curso.subtitulo}
      </p>

      <p class="text-sm md:text-base text-white/85 leading-relaxed max-w-2xl mb-6">
        {curso.descripcion}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-sm font-bold">
        <span class="flex items-center gap-2 bg-white/15 backdrop-blur rounded-full px-4 py-2">
          📚 {curso.total_capitulos} capítulos
        </span>
        <span class="flex items-center gap-2 bg-white/15 backdrop-blur rounded-full px-4 py-2">
          ⭐ +{curso.progreso_puntos_por_capitulo} XP por capítulo
        </span>
        <span class="flex items-center gap-2 bg-white/15 backdrop-blur rounded-full px-4 py-2">
          🎬 {curso.fuente}
        </span>
      </div>
    </div>
  </div>

  <!-- 📖 ÍNDICE DE CAPÍTULOS -->
  <section>
    <div class="flex items-center gap-3 mb-4">
      <span class="text-3xl">📖</span>
      <h2 class="text-2xl font-extrabold text-gray-800">
        Índice del curso
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

      {capitulosActivos.map((cap) => (
        <a
          href={`/curso/${curso.id}/${cap.id}`}
          class="group block bg-white rounded-3xl p-5 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-14 h-14 rounded-2xl flex items-center justify-center text-white text-xl font-extrabold shadow-md" style={estiloNumero}>
              {cap.numero_romano}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xl">{cap.emoji}</span>
                <span class="text-xs font-bold uppercase tracking-wide" style={`color: ${c.c600};`}>
                  Capítulo {cap.numero}
                </span>
              </div>
              <h3 class="text-base md:text-lg font-extrabold text-gray-800 leading-tight mb-1">
                {cap.titulo}
              </h3>
              <p class="text-xs md:text-sm text-gray-500 leading-snug mb-2">
                {cap.subtitulo}
              </p>
              <span class="font-bold text-sm group-hover:translate-x-1 transition-transform inline-block" style={`color: ${c.c500};`}>
                Entrar al capítulo →
              </span>
            </div>
          </div>
        </a>
      ))}

      {capitulosPendientes.map((cap) => (
        <div class="block bg-white/50 rounded-3xl p-5 shadow-sm border border-dashed border-gray-200 opacity-60 cursor-not-allowed">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-gray-100 flex items-center justify-center text-gray-400 text-xl font-extrabold">
              {cap.numero_romano}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xl grayscale">🔒</span>
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">
                  Capítulo {cap.numero}
                </span>
              </div>
              <h3 class="text-base md:text-lg font-extrabold text-gray-500 leading-tight mb-1">
                {cap.titulo}
              </h3>
              <p class="text-xs md:text-sm text-gray-400 leading-snug">
                Próximamente
              </p>
            </div>
          </div>
        </div>
      ))}

    </div>
  </section>

  <!-- 💡 Nota al pie -->
  <div class="rounded-2xl p-4 text-sm text-gray-700" style={`background: ${c.c50}; border-left: 4px solid ${c.c500};`}>
    <p class="font-bold mb-1">💡 Sobre este curso</p>
    <p class="leading-relaxed">
      {curso.descripcion}
    </p>
  </div>

</div>
