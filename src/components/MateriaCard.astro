---
interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  emoji: string;
  color: string;
  cantidad?: number;
  etiquetaCantidad?: string;
}

const {
  id,
  nombre,
  descripcion,
  emoji,
  color,
  cantidad,
  etiquetaCantidad = "lecciones",
} = Astro.props;

const gradienteMap: Record<string, string> = {
  lenguaje: "from-lenguaje-400 to-lenguaje-600",
  matematicas: "from-matematicas-400 to-matematicas-600",
  historia: "from-historia-400 to-historia-600",
  ingles: "from-ingles-400 to-ingles-600",
  ciencias: "from-ciencias-400 to-ciencias-600",
};

const etiquetaMap: Record<string, string> = {
  lenguaje: "bg-lenguaje-100 text-lenguaje-600",
  matematicas: "bg-matematicas-100 text-matematicas-600",
  historia: "bg-historia-100 text-historia-600",
  ingles: "bg-ingles-100 text-ingles-600",
  ciencias: "bg-ciencias-100 text-ciencias-600",
};

const hoverMap: Record<string, string> = {
  lenguaje: "text-lenguaje-500",
  matematicas: "text-matematicas-500",
  historia: "text-historia-500",
  ingles: "text-ingles-500",
  ciencias: "text-ciencias-500",
};

const gradiente = gradienteMap[color] || gradienteMap.ciencias;
const etiqueta = etiquetaMap[color] || etiquetaMap.ciencias;
const hover = hoverMap[color] || hoverMap.ciencias;
---

<a
  href={`/materia/${id}`}
  class="group block bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
>
  <div class="flex items-start justify-between mb-4">
    <div
      class={`w-16 h-16 md:w-20 md:h-20 rounded-3xl bg-gradient-to-br ${gradiente} flex items-center justify-center text-4xl md:text-5xl shadow-md`}
    >
      {emoji}
    </div>
    {cantidad !== undefined && (
      <span class={`text-xs font-bold px-3 py-1 rounded-full ${etiqueta}`}>
        {cantidad} {etiquetaCantidad}
      </span>
    )}
  </div>
  <h3 class="text-xl md:text-2xl font-extrabold text-gray-800 mb-1">
    {nombre}
  </h3>
  <p class="text-sm text-gray-500 mb-4 leading-snug">
    {descripcion}
  </p>
  <div class="flex items-center justify-end">
    <span
      class={`font-extrabold ${hover} group-hover:translate-x-1 transition-transform inline-block`}
    >
      Entrar →
    </span>
  </div>
</a>
