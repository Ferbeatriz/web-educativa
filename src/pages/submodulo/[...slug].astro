---
import Layout from '../../layouts/Layout.astro';

// Le decimos a Astro qué páginas generar
export async function getStaticPaths() {
  // Cargar todas las materias (para saber sus colores y nombres)
  const materiasFiles = import.meta.glob('../../data/materias/*/materia.json', { eager: true });
  const materiasMap: Record<string, any> = {};
  for (const path in materiasFiles) {
    const data = (materiasFiles[path] as any).default;
    materiasMap[data.id] = data;
  }

  // Cargar TODOS los submodulo.json que existan en cualquier nivel
  const submodulosFiles = import.meta.glob(
    '../../data/materias/**/submodulos/**/submodulo.json',
    { eager: true }
  );

  // Cargar submodulos de Antiguo Egipto (anidados dentro de lecciones/)
  const submodulosAnidados = import.meta.glob(
    '../../data/materias/**/lecciones/**/submodulo.json',
    { eager: true }
  );

  const allSubmodulos = { ...submodulosFiles, ...submodulosAnidados };

  const paths = [];

  for (const path in allSubmodulos) {
    const submodulo = (allSubmodulos[path] as any).default;

    // Detectar la materia a la que pertenece buscando en la ruta
    let materiaId = null;
    for (const mid in materiasMap) {
      if (path.includes(`/materias/${mid}/`)) {
        materiaId = mid;
        break;
      }
    }
    if (!materiaId) continue;

    // Construir el slug según la ubicación del archivo
    // Ej: historia-universal → ['historia', 'historia-universal']
    // Ej: antiguo-egipto → ['historia', 'historia-universal', 'antiguo-egipto']
    let slugParts: string[] = [materiaId];

    // Extraer las partes del path entre "submodulos/" (o "lecciones/") y "/submodulo.json"
    const match = path.match(/\/(?:submodulos|lecciones)\/(.+?)\/submodulo\.json$/);
    if (match) {
      const partes = match[1].split('/').filter((p) => !p.startsWith('submodulos') && !p.startsWith('lecciones'));
      slugParts = [materiaId, ...partes];
    }

    paths.push({
      params: { slug: slugParts.join('/') },
      props: {
        submodulo,
        materia: materiasMap[materiaId],
        rutaArchivo: path,
      },
    });
  }

  return paths;
}

const { submodulo, materia } = Astro.props;

// Mapa de gradientes por color de materia
const gradienteMap: Record<string, string> = {
  lenguaje: "from-lenguaje-400 to-lenguaje-600",
  matematicas: "from-matematicas-400 to-matematicas-600",
  historia: "from-historia-400 to-historia-600",
  ingles: "from-ingles-400 to-ingles-600",
  ciencias: "from-ciencias-400 to-ciencias-600",
};
const gradiente = gradienteMap[materia.color] || gradienteMap.ciencias;

// ¿Tiene lecciones o submodulos anidados?
const tieneLecciones = submodulo.lecciones && submodulo.lecciones.length > 0;
const tieneCursos = submodulo.cursos_especiales && submodulo.cursos_especiales.length > 0;

// Ruta base para los enlaces de lecciones de este submódulo
const slugBase = Astro.params.slug; // ej: "historia/historia-universal"
---

<Layout title={`${submodulo.nombre} · ${materia.nombre}`}>
  <main class="max-w-4xl mx-auto px-4 py-6 md:py-10">

    <!-- Breadcrumb simple -->
    <nav class="text-sm font-bold mb-6 flex items-center gap-2 flex-wrap">
      <a href="/" class="text-brand-600 hover:underline">Inicio</a>
      <span class="text-gray-300">›</span>
      <a href={`/materia/${materia.id}`} class="text-brand-600 hover:underline">
        {materia.nombre}
      </a>
      <span class="text-gray-300">›</span>
      <span class="text-gray-500">{submodulo.nombre}</span>
    </nav>

    <!-- Cabecera del submódulo -->
    <header class="mb-8">
      <div class="flex items-center gap-4 mb-3">
        <div class={`w-20 h-20 md:w-24 md:h-24 rounded-3xl bg-gradient-to-br ${gradiente} flex items-center justify-center text-5xl md:text-6xl shadow-lg`}>
          {submodulo.emoji}
        </div>
        <div>
          <span class="text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-600">
            {materia.nombre}
          </span>
          <h1 class="text-3xl md:text-4xl font-extrabold text-gray-800 mt-2">
            {submodulo.nombre}
          </h1>
          <p class="text-gray-500 font-bold mt-1">
            {submodulo.descripcion}
          </p>
        </div>
      </div>
    </header>

    <!-- LECCIONES DEL SUBMÓDULO -->
    {tieneLecciones && (
      <section class="mb-8">
        <h2 class="text-xl md:text-2xl font-extrabold text-gray-800 mb-4">
          📚 Lecciones
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {submodulo.lecciones
            .filter((l: any) => l.activa !== false && l.activo !== false)
            .sort((a: any, b: any) => (a.orden || 0) - (b.orden || 0))
            .map((lec: any) => {
              // Detectar si es un submódulo anidado
              const esAnidado = lec.tipo === 'submodulo_anidado';
              const href = esAnidado
                ? `/submodulo/${slugBase}/${lec.id}`
                : `/leccion/${materia.id}/${lec.id}`;

              return (
                <a
                  href={href}
                  class="group block bg-white rounded-3xl p-5 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                >
                  <div class="flex items-start justify-between mb-3">
                    <div class="w-12 h-12 rounded-2xl bg-gray-50 flex items-center justify-center text-2xl shadow-sm">
                      {lec.emoji}
                    </div>
                    {lec.nivel && (
                      <span class="text-xs font-bold px-3 py-1 rounded-full bg-gray-100 text-gray-600">
                        {lec.nivel}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-extrabold text-gray-800 mb-1">
                    {lec.titulo}
                  </h3>
                  {lec.duracion_estimada_min && (
                    <p class="text-xs text-gray-400 font-bold mb-3">
                      ⏱️ ~{lec.duracion_estimada_min} min
                    </p>
                  )}
                  <span class="text-brand-500 font-bold group-hover:translate-x-1 transition-transform inline-block">
                    {esAnidado ? "Explorar →" : "Empezar →"}
                  </span>
                </a>
              );
            })
          }
        </div>
      </section>
    )}

    <!-- CURSOS ESPECIALES -->
    {tieneCursos && (
      <section class="mb-8">
        <h2 class="text-xl md:text-2xl font-extrabold text-gray-800 mb-4">
          🌟 Cursos Especiales
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {submodulo.cursos_especiales
            .filter((c: any) => c.activo !== false)
            .sort((a: any, b: any) => (a.orden || 0) - (b.orden || 0))
            .map((curso: any) => (
              <a
                href={`/curso/${curso.id}`}
                class="group block bg-gradient-to-br from-brand-500 to-brand-700 rounded-3xl p-5 shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 text-white"
              >
                <div class="flex items-start justify-between mb-3">
                  <div class="w-12 h-12 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center text-2xl shadow-sm">
                    {curso.emoji}
                  </div>
                  <span class="text-xs font-bold px-3 py-1 rounded-full bg-white/20 backdrop-blur">
                    ✨ Especial
                  </span>
                </div>
                <h3 class="text-lg font-extrabold mb-1">
                  {curso.titulo}
                </h3>
                <p class="text-sm text-white/80 mb-3 leading-snug">
                  {curso.descripcion}
                </p>
                <span class="font-bold group-hover:translate-x-1 transition-transform inline-block">
                  Descubrir →
                </span>
              </a>
            ))
          }
        </div>
      </section>
    )}

    <!-- Estado vacío -->
    {!tieneLecciones && !tieneCursos && (
      <div class="bg-white rounded-3xl p-8 text-center shadow-sm border border-gray-100">
        <div class="text-6xl mb-4">🚧</div>
        <h3 class="text-xl font-extrabold text-gray-800 mb-2">
          Próximamente
        </h3>
        <p class="text-gray-500">
          Estamos preparando contenido para este submódulo.
        </p>
      </div>
    )}

  </main>
</Layout>
