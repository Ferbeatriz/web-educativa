---
import Layout from '../layouts/Layout.astro';
---

<Layout title="¿Qué aprende esta semana? — Aprende Jugando">
  <main class="min-h-[70vh]">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-purple-600 to-indigo-600 text-white">
      <div class="max-w-4xl mx-auto px-4 py-16 md:py-24 text-center">
        <p class="text-sm md:text-base font-semibold uppercase tracking-widest text-purple-200 mb-3">
          Para apoderados
        </p>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-4">
          ¿Qué está aprendiendo tu hija esta semana?
        </h1>
        <p class="text-base md:text-lg text-purple-100 max-w-2xl mx-auto">
          Un vistazo rápido a lo que está trabajando en la plataforma, con ideas simples para apoyarla en casa en solo 10 minutos.
        </p>
      </div>
    </section>

    <!-- Tarjeta central -->
    <section class="max-w-3xl mx-auto px-4 -mt-10 md:-mt-16 relative z-10">
      <div class="bg-white rounded-3xl shadow-xl p-6 md:p-10 border border-gray-100">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-4xl">🍕</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
            Introducción a las Fracciones
          </h2>
        </div>
        <p class="text-gray-600 mb-6">
          Esta semana tu hija está conociendo qué es una fracción y para qué sirve, usando ejemplos cotidianos como pizzas, barras de chocolate y queques.
        </p>

        <div class="bg-purple-50 border border-purple-100 rounded-2xl p-4 md:p-5">
          <p class="text-xs font-bold text-purple-700 uppercase tracking-wide mb-1">
            OA del MINEDUC
          </p>
          <p class="text-gray-800 text-sm md:text-base leading-relaxed">
            <strong>OA 11:</strong> Demostrar que comprenden las fracciones de uso común: 1/4, 1/3, 1/2, 2/3, 3/4.
          </p>
        </div>
      </div>
    </section>

    <!-- 3 Tips -->
    <section class="max-w-3xl mx-auto px-4 py-12 md:py-16">
      <h3 class="text-xl md:text-2xl font-extrabold text-gray-800 text-center mb-8">
        3 tips para apoyar en casa
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-100">
          <div class="text-3xl mb-3">🍕</div>
          <p class="text-gray-700 leading-relaxed">
            Dividan una pizza o un queque en partes iguales y coman una fracción.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-100">
          <div class="text-3xl mb-3">🍫</div>
          <p class="text-gray-700 leading-relaxed">
            Usen una barra de chocolate para contar los cuadritos y armar fracciones.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow-md p-6 border border-gray-100">
          <div class="text-3xl mb-3">🗣️</div>
          <p class="text-gray-700 leading-relaxed">
            Pídanle que explique qué es el numerador y el denominador con sus propias palabras.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-3xl mx-auto px-4 pb-16 text-center">
      <a
        href="/login"
        class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 text-white font-bold text-lg rounded-2xl shadow-lg hover:bg-purple-700 transition"
      >
        Ir a la plataforma →
      </a>
      <p class="text-sm text-gray-500 mt-4">
        Inicia sesión para que tu hija continúe aprendiendo.
      </p>
    </section>
  </main>
</Layout>
