---
import Layout from '../../../layouts/Layout.astro';
import CuestionarioAleatorio from '../../../components/comprension/CuestionarioAleatorio.astro';
import TutorAnalisis from '../../../components/ejercicios/TutorAnalisis.astro';
import indice from '../../../data/materias/lenguaje/lecturas/indice.json';

import metaManu from '../../../data/materias/lenguaje/lecturas/la-historia-de-manu/meta.json';
import bancoComprensionManu from '../../../data/materias/lenguaje/lecturas/la-historia-de-manu/banco-comprension.json';
import bancoDesarrolloManu from '../../../data/materias/lenguaje/lecturas/la-historia-de-manu/banco-desarrollo.json';
import bancoRelecturaManu from '../../../data/materias/lenguaje/lecturas/la-historia-de-manu/banco-relectura.json';
import bancoAnalisisManu from '../../../data/materias/lenguaje/lecturas/la-historia-de-manu/banco-analisis.json';

import metaLugar from '../../../data/materias/lenguaje/lecturas/el-lugar-mas-bonito-del-mundo/meta.json';
import bancoComprensionLugar from '../../../data/materias/lenguaje/lecturas/el-lugar-mas-bonito-del-mundo/banco-comprension.json';
import bancoDesarrolloLugar from '../../../data/materias/lenguaje/lecturas/el-lugar-mas-bonito-del-mundo/banco-desarrollo.json';
import bancoRelecturaLugar from '../../../data/materias/lenguaje/lecturas/el-lugar-mas-bonito-del-mundo/banco-relectura.json';
import bancoAnalisisLugar from '../../../data/materias/lenguaje/lecturas/el-lugar-mas-bonito-del-mundo/banco-analisis.json';

import metaBartolo from '../../../data/materias/lenguaje/lecturas/la-cama-magica-de-bartolo/meta.json';
import bancoComprensionBartolo from '../../../data/materias/lenguaje/lecturas/la-cama-magica-de-bartolo/banco-comprension.json';
import bancoDesarrolloBartolo from '../../../data/materias/lenguaje/lecturas/la-cama-magica-de-bartolo/banco-desarrollo.json';
import bancoRelecturaBartolo from '../../../data/materias/lenguaje/lecturas/la-cama-magica-de-bartolo/banco-relectura.json';
import bancoAnalisisBartolo from '../../../data/materias/lenguaje/lecturas/la-cama-magica-de-bartolo/banco-analisis.json';

const datosLibros = {
  'la-historia-de-manu': { meta: metaManu, trivia: { bancoComprension: bancoComprensionManu.preguntas, bancoDesarrollo: bancoDesarrolloManu.preguntas, bancoRelectura: bancoRelecturaManu.desafios }, analisis: bancoAnalisisManu },
  'el-lugar-mas-bonito-del-mundo': { meta: metaLugar, trivia: { bancoComprension: bancoComprensionLugar.preguntas, bancoDesarrollo: bancoDesarrolloLugar.preguntas, bancoRelectura: bancoRelecturaLugar.desafios }, analisis: bancoAnalisisLugar },
  'la-cama-magica-de-bartolo': { meta: metaBartolo, trivia: { bancoComprension: bancoComprensionBartolo.preguntas, bancoDesarrollo: bancoDesarrolloBartolo.preguntas, bancoRelectura: bancoRelecturaBartolo.desafios }, analisis: bancoAnalisisBartolo },
};

export function getStaticPaths() {
  return indice.libros.filter(libro => libro.activo).map(libro => ({
    params: { libro: libro.id },
    props: { libroId: libro.id },
  }));
}

const { libro: libroId } = Astro.params;
const libroActivo = indice.libros.find(l => l.id === libroId);
if (!libroActivo || !datosLibros[libroId]) return Astro.redirect('/lenguaje');

const datos = datosLibros[libroId];
const meta = datos.meta;
---

<Layout titulo={`${meta.titulo} — Comprensión lectora`}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    
    <a href="/lenguaje" class="text-purple-600 font-bold hover:underline mb-6 inline-block">← Volver al Club de Lectura</a>

    <!-- Encabezado del libro -->
    <div class="flex items-center gap-6 mb-8 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div class="text-6xl">{meta.emoji}</div>
      <div>
        <h1 class="text-3xl font-extrabold text-gray-800">{meta.titulo}</h1>
        <p class="text-gray-600 font-medium">de {meta.autora}</p>
      </div>
    </div>

    <!-- Pestañas -->
    <div class="flex gap-4 mb-8 bg-gray-50 p-2 rounded-xl w-fit">
      <button id="btn-trivia" class="px-6 py-3 rounded-lg font-bold transition-all bg-purple-600 text-white shadow-md cursor-pointer">
        📖 Comprensión y Trivia
      </button>
      <button id="btn-analisis" class="px-6 py-3 rounded-lg font-bold transition-all text-gray-600 hover:bg-gray-200 cursor-pointer">
        🕵️ Análisis Guiado
      </button>
    </div>

    <script is:inline define:vars={{ datosParaElCliente: datos.trivia }}>
      window.__CUESTIONARIO_DATOS__ = datosParaElCliente;
    </script>

    <!-- Sección Trivia -->
    <div id="seccion-trivia" class="block">
      <CuestionarioAleatorio
        libroId={libroId}
        libroTitulo={meta.titulo}
        bancoComprension={datos.trivia.bancoComprension}
        bancoDesarrollo={datos.trivia.bancoDesarrollo}
        bancoRelectura={datos.trivia.bancoRelectura}
        configuracion={meta.configuracion}
      />
    </div>

    <!-- Sección Análisis Guiado -->
    <div id="seccion-analisis" class="hidden">
      <TutorAnalisis analisis={datos.analisis} />
    </div>

  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btnTrivia = document.getElementById('btn-trivia');
      const btnAnalisis = document.getElementById('btn-analisis');
      const secTrivia = document.getElementById('seccion-trivia');
      const secAnalisis = document.getElementById('seccion-analisis');

      if (!btnTrivia || !btnAnalisis || !secTrivia || !secAnalisis) return;

      btnTrivia.addEventListener('click', () => {
        secTrivia.classList.remove('hidden');
        secAnalisis.classList.add('hidden');
        btnTrivia.className = 'px-6 py-3 rounded-lg font-bold transition-all bg-purple-600 text-white shadow-md cursor-pointer';
        btnAnalisis.className = 'px-6 py-3 rounded-lg font-bold transition-all text-gray-600 hover:bg-gray-200 cursor-pointer';
      });

      btnAnalisis.addEventListener('click', () => {
        secTrivia.classList.add('hidden');
        secAnalisis.classList.remove('hidden');
        btnAnalisis.className = 'px-6 py-3 rounded-lg font-bold transition-all bg-purple-600 text-white shadow-md cursor-pointer';
        btnTrivia.className = 'px-6 py-3 rounded-lg font-bold transition-all text-gray-600 hover:bg-gray-200 cursor-pointer';
      });
    });
  </script>
</Layout>