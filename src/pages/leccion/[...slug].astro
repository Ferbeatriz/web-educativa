---
import Layout from '../../layouts/Layout.astro';
import TriviaQuiz from '../../components/TriviaQuiz.astro';

// Le decimos a Astro qué páginas generar (una por cada lección con archivo JSON)
export async function getStaticPaths() {
  // Cargar todas las materias (para color y contexto)
  const materiasFiles = import.meta.glob('../../data/materias/*/materia.json', { eager: true });
  const materiasMap: Record<string, any> = {};
  for (const path in materiasFiles) {
    const data = (materiasFiles[path] as any).default;
    materiasMap[data.id] = data;
  }

  // Cargar TODOS los .json de lecciones
  const leccionesFiles = import.meta.glob(
    '../../data/materias/**/lecciones/**/*.json',
    { eager: true }
  );

  // ⚠️ ESTA LÍNEA FALTABA
  const paths = [];

  for (const path in leccionesFiles) {
    // Saltar los submodulo.json (esos los maneja /submodulo/[...slug])
    if (path.endsWith('/submodulo.json')) continue;

    // Protección: saltar archivos con JSON inválido
    let leccion;
    try {
      leccion = (leccionesFiles[path] as any).default;
    } catch (e) {
      console.warn(`⚠️ Saltando archivo con JSON inválido: ${path}`);
      continue;
    }

    // Saltar si no tiene id
    if (!leccion || !leccion.id) continue;

    // Detectar la materia a la que pertenece
    let materiaId = null;
    for (const mid in materiasMap) {
      if (path.includes(`/materias/${mid}/`)) {
        materiaId = mid;
        break;
      }
    }
    if (!materiaId) continue;

    paths.push({
      params: { slug: `${materiaId}/${leccion.id}` },
      props: {
        leccion,
        materia: materiasMap[materiaId],
      },
    });
  }

  return paths;
}

const { leccion, materia } = Astro.props;

// Mapa de gradientes por color de materia
const gradienteMap: Record<string, string> = {
  lenguaje: "from-lenguaje-400 to-lenguaje-600",
  matematicas: "from-matematicas-400 to-matematicas-600",
  historia: "from-historia-400 to-historia-600",
  ingles: "from-ingles-400 to-ingles-600",
  ciencias: "from-ciencias-400 to-ciencias-600",
};
const gradiente = gradienteMap[materia.color] || gradienteMap.ciencias;

// Contenido y trivia
const contenido = leccion.contenido_modulos || [];
const trivia = leccion.trivia || [];
---

<Layout title={`${leccion.titulo} · ${materia.nombre}`}>
  <main class="max-w-3xl mx-auto px-4 py-6 md:py-10">

    <!-- Breadcrumb -->
    <nav class="text-sm font-bold mb-6 flex items-center gap-2 flex-wrap">
      <a href="/" class="text-brand-600 hover:underline">Inicio</a>
      <span class="text-gray-300">›</span>
      <a href={`/materia/${materia.id}`} class="text-brand-600 hover:underline">
        {materia.nombre}
      </a>
      <span class="text-gray-300">›</span>
      <span class="text-gray-500">{leccion.titulo}</span>
    </nav>

    <!-- Cabecera de la lección -->
    <header class="mb-8">
      <div class={`w-20 h-20 rounded-3xl bg-gradient-to-br ${gradiente} flex items-center justify-center text-5xl shadow-lg mb-4`}>
        {leccion.emoji || materia.emoji}
      </div>
      {leccion.categoria && (
        <span class="inline-block text-xs font-bold px-3 py-1 rounded-full bg-brand-100 text-brand-700 mb-3">
          {leccion.categoria}
        </span>
      )}
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-800 mb-2">
        {leccion.titulo}
      </h1>
      {leccion.progreso_puntos && (
        <p class="text-gray-500 font-bold">
          +{leccion.progreso_puntos} XP al completar
        </p>
      )}
    </header>

    <!-- Contenido modular -->
    {contenido.length > 0 ? (
      <section class="space-y-4 mb-10">
        {contenido.map((parrafo: string, idx: number) => (
          <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-gray-100">
            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-100 text-brand-700 font-extrabold flex items-center justify-center text-xs">
                {idx + 1}
              </span>
              <p class="text-base md:text-lg text-gray-700 leading-relaxed font-semibold">
                {parrafo}
              </p>
            </div>
          </div>
        ))}
      </section>
    ) : (
      <div class="bg-white rounded-3xl p-8 text-center shadow-sm border border-gray-100 mb-10">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-xl font-extrabold text-gray-800 mb-2">
          Contenido en preparación
        </h3>
        <p class="text-gray-500">
          Esta lección se está redactando. ¡Vuelve pronto!
        </p>
      </div>
    )}

    <!-- Trivia -->
    {trivia.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-5">
          <span class="text-3xl">🧠</span>
          <h2 class="text-2xl font-extrabold text-gray-800">
            ¡Ahora te toca!
          </h2>
        </div>
        <TriviaQuiz trivia={trivia} />
      </section>
    )}

    <!-- Botón volver al final -->
    <div class="mt-10 text-center">
      <a
        href={`/materia/${materia.id}`}
        class="inline-block px-6 py-3 rounded-2xl bg-white border border-gray-200 text-gray-600 font-bold hover:border-brand-300 hover:text-brand-600 transition-all"
      >
        ← Volver a {materia.nombre}
      </a>
    </div>

  </main>
</Layout>
