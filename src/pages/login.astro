---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar sesión — Web Educativa">
  <main class="min-h-screen flex items-center justify-center px-4 py-12 bg-gray-50">
    <div class="w-full max-w-md">
      
      <!-- Encabezado -->
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-purple-600 mb-2">
          🎓 Web Educativa
        </h1>
        <p class="text-gray-600 text-sm">
          Ingresa con tu usuario y contraseña
        </p>
      </div>

      <!-- Formulario -->
      <div class="bg-white rounded-2xl shadow-lg p-8">
        <form id="login-form" class="space-y-5">
          
          <!-- Usuario -->
          <div>
            <label for="usuario" class="block text-sm font-medium text-gray-700 mb-2">
              Usuario
            </label>
            <input
              type="text"
              id="usuario"
              name="usuario"
              required
              autocomplete="username"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition"
              placeholder="Ej: Fer01"
            />
          </div>

          <!-- Contraseña -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
              Contraseña
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition"
              placeholder="Tu contraseña"
            />
          </div>

          <!-- Mensaje de error -->
          <div id="error-message" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-3">
          </div>

          <!-- Botón -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Entrar
          </button>
        </form>
      </div>

      <!-- Footer -->
      <p class="text-center text-xs text-gray-500 mt-6">
        ¿Olvidaste tu contraseña? Pídele a tu profesora que la restablezca.
      </p>
    </div>
  </main>

  <script>
    import { login } from '../lib/auth';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const usuarioInput = document.getElementById('usuario') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    // Si ya hay sesión, redirigir al inicio
    import { isLoggedIn } from '../lib/auth';
    if (isLoggedIn()) {
      window.location.href = '/';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Limpiar estado anterior
      errorDiv.classList.add('hidden');
      errorDiv.textContent = '';

      const usuario = usuarioInput.value.trim();
      const password = passwordInput.value;

      if (!usuario || !password) {
        mostrarError('Por favor completa todos los campos.');
        return;
      }

      // Estado de carga
      submitBtn.disabled = true;
      submitBtn.textContent = 'Entrando...';

      try {
        const result = await login(usuario, password);

        if (result.ok) {
          submitBtn.textContent = '¡Bienvenida!';
          // Redirigir a la página principal
          window.location.href = '/';
        } else {
          mostrarError(result.error || 'Usuario o contraseña incorrectos.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Entrar';
          passwordInput.value = '';
          passwordInput.focus();
        }
      } catch (err) {
        mostrarError('Error inesperado. Intenta de nuevo.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Entrar';
      }
    });

    function mostrarError(mensaje: string) {
      errorDiv.textContent = mensaje;
      errorDiv.classList.remove('hidden');
    }
  </script>
</Layout>
