---
import Layout from '../layouts/Layout.astro';
import MateriaCard from '../components/MateriaCard.astro';

import materiasData from '../data/materias.json';

const materias = materiasData.materias
  .filter((m: any) => m.activo)
  .sort((a: any, b: any) => a.orden - b.orden);
---

<Layout title="Aprende Jugando 🚀">
  <main id="dashboard-protegido" class="hidden max-w-5xl mx-auto px-4 py-8 md:py-12">

    <!-- HERO -->
    <section class="mb-10">
      <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-500 via-brand-600 to-brand-700 p-6 md:p-10 shadow-xl">

        <div class="absolute -top-6 -right-6 text-[200px] leading-none opacity-10 select-none pointer-events-none">
          🦉
        </div>

        <div class="relative z-10">
          <h1 id="hero-saludo" class="text-3xl md:text-5xl font-extrabold text-white mb-3 leading-tight">
            ¡Hola, exploradora! 👋
          </h1>
          <p class="text-base md:text-lg text-white/90 font-bold mb-6">
            ¿Qué quieres aprender hoy? ✨
          </p>

          <div class="bg-white/15 backdrop-blur rounded-2xl p-4 max-w-md">
            <div class="flex items-center justify-between mb-2">
              <span id="hero-nivel" class="text-xs md:text-sm font-extrabold text-white/90 uppercase tracking-wide">
                ⭐ Cargando...
              </span>
              <span id="hero-xp" class="text-xs md:text-sm font-extrabold text-white">
                — XP
              </span>
            </div>
            <div class="w-full h-2.5 bg-white/20 rounded-full overflow-hidden">
              <div id="hero-barra" class="h-full bg-white rounded-full transition-all duration-700" style="width: 0%"></div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- RACHA (solo una vez) -->
    <section class="mb-8">
      <div id="racha-card" class="hidden bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="text-4xl" id="racha-emoji">🔥</div>
        <div class="flex-1">
          <p class="text-xs text-gray-500 font-bold uppercase tracking-wide mb-0.5">
            Racha
          </p>
          <p class="text-lg font-extrabold text-gray-800" id="racha-texto">
            Cargando...
          </p>
        </div>
      </div>
    </section>

    <!-- MATERIAS -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl">📚</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
          Tus materias
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {materias.map((materia: any) => (
          <MateriaCard materia={materia} />
        ))}
      </div>
    </section>

  </main>

  <script is:inline>
    import { getAlumna, isLoggedIn } from '../lib/auth';
    import {
      getResumenProgreso,
      getRacha,
      getProgresoPorMateria,
    } from '../lib/progreso';

    async function init() {
      // 1. Verificar sesión
      if (!isLoggedIn()) {
        window.location.href = '/login';
        return;
      }

      // 2. Mostrar el dashboard
      const dashboard = document.getElementById('dashboard-protegido');
      dashboard?.classList.remove('hidden');

      // 3. Personalizar el saludo
      const alumna = getAlumna();
      const saludo = document.getElementById('hero-saludo');
      if (alumna && saludo) {
        const primerNombre = alumna.nombre.split(' ')[0];
        saludo.textContent = `¡Hola, ${primerNombre}! 👋`;
      }

      // 4. Obtener datos reales de progreso
      const resultado = await getResumenProgreso();

      if (resultado.ok && resultado.resumen && resultado.nivel) {
        const { resumen, nivel } = resultado;

        const nivelLabel = document.getElementById('hero-nivel');
        if (nivelLabel) {
          nivelLabel.textContent = `⭐ Nivel ${nivel.numero} · ${nivel.nombre} ${nivel.emoji}`;
        }

        const xpLabel = document.getElementById('hero-xp');
        if (xpLabel) {
          if (nivel.es_maximo) {
            xpLabel.textContent = `${nivel.xp_total} XP`;
          } else {
            xpLabel.textContent = `${nivel.xp_total} / ${nivel.xp_siguiente_total} XP`;
          }
        }

        const barra = document.getElementById('hero-barra') as HTMLElement;
        if (barra) {
          barra.style.width = `${nivel.porcentaje}%`;
        }
      }

      // 5. Cargar racha
      const rachaRes = await getRacha();
      if (rachaRes && rachaRes.ok && rachaRes.racha) {
        const r = rachaRes.racha;
        const card = document.getElementById('racha-card');
        const texto = document.getElementById('racha-texto');
        const emoji = document.getElementById('racha-emoji');

        if (card && texto) {
          card.classList.remove('hidden');

          if (r.activo_hoy && r.dias_consecutivos >= 2) {
            texto.textContent = `${r.dias_consecutivos} días seguidos`;
          } else if (r.activo_hoy) {
            texto.textContent = `¡Empezaste hoy!`;
          } else if (r.dias_consecutivos >= 2) {
            texto.textContent = `Tu última racha fue de ${r.dias_consecutivos} días`;
          } else if (r.dias_activos_totales > 0) {
            texto.textContent = `Nos vemos cuando quieras`;
          } else {
            texto.textContent = `Completa una lección para empezar`;
          }

          if (!r.activo_hoy && emoji) {
            emoji.textContent = '✨';
          }
        }
      }

      // 6. Cargar progreso por materia
      const progRes = await getProgresoPorMateria();
      if (progRes && progRes.ok && progRes.materias) {
        const porMateria = new Map(
          progRes.materias.map((m) => [m.materia_id, m.completadas])
        );

        const colores: Record<string, string> = {
          lenguaje: '#EC4899',
          matematicas: '#3B82F6',
          historia: '#F59E0B',
          ingles: '#14B8A6',
          ciencias: '#84CC16',
          programacion: '#D946EF',
        };

        document.querySelectorAll<HTMLElement>('[data-materia-id]').forEach((card) => {
          const materiaId = card.dataset.materiaId;
          if (!materiaId) return;

          const el = card.querySelector<HTMLElement>('.materia-progreso');
          if (!el) return;

          const completadas = porMateria.get(materiaId) || 0;
          const total = parseInt(card.dataset.totalLecciones || '0', 10);

          if (total === 0) return;

          el.classList.remove('hidden');

          const texto = el.querySelector('.progreso-texto');
          const barra = el.querySelector('.progreso-barra') as HTMLElement | null;

          if (texto) {
            texto.textContent = `${completadas} de ${total}`;
          }

          if (barra) {
            const pct = Math.round((completadas / total) * 100);
            barra.style.width = `${pct}%`;
            const colorKey = card.dataset.color;
            if (colorKey) {
              barra.style.background = colores[colorKey] || '#8B5CF6';
            }
          }
        });
      }
    }

    init();
  </script>

</Layout>
