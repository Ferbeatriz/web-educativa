---
import Layout from '../layouts/Layout.astro';
import MateriaCard from '../components/MateriaCard.astro';

// Leer el índice de materias
import materiasData from '../data/materias.json';

const materias = materiasData.materias
  .filter((m: any) => m.activo)
  .sort((a: any, b: any) => a.orden - b.orden);

// Función auxiliar para saber cuántas lecciones tiene cada materia
const contarLecciones = (materia: any) => {
  if (materia.submodulos && materia.submodulos.length > 0) {
    return materia.submodulos.length;
  }
  return 0;
};

const etiquetaCantidad = (materia: any) => {
  if (materia.submodulos && materia.submodulos.length > 0) return "submódulos";
  return "lecciones";
};
---

<Layout title="Aprende Jugando 🚀">
  <main class="max-w-4xl mx-auto px-4 py-6 md:py-10">

    <!-- CABECERA -->
    <header class="mb-8">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-800">
            ¡Hola, exploradora! 👋
          </h1>
          <p class="text-gray-500 text-sm md:text-base mt-1">
            ¿Qué quieres aprender hoy? ✨
          </p>
        </div>
        <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-brand-500 flex items-center justify-center text-2xl md:text-3xl shadow-lg animate-float">
          🦊
        </div>
      </div>

      <!-- Barra de progreso estilo videojuego -->
      <div class="bg-white rounded-3xl p-5 shadow-sm border border-gray-100">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm md:text-base font-bold text-gray-700">
            Nivel 3 · Exploradora
          </span>
          <span class="text-sm md:text-base font-extrabold text-brand-600">
            120 / 200 XP
          </span>
        </div>
        <div class="w-full h-3 bg-gray-100 rounded-full overflow-hidden">
          <div
            class="h-full bg-gradient-to-r from-brand-400 to-brand-600 rounded-full transition-all duration-700"
            style="width: 60%">
          </div>
        </div>
      </div>
    </header>

    <!-- MATERIAS -->
    <section>
      <h2 class="text-xl md:text-2xl font-extrabold text-gray-800 mb-4">
        📚 Tus materias
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {materias.map((materia: any) => (
          <MateriaCard
            id={materia.id}
            nombre={materia.nombre}
            descripcion={materia.descripcion}
            emoji={materia.emoji}
            color={materia.color}
            cantidad={contarLecciones(materia)}
            etiquetaCantidad={etiquetaCantidad(materia)}
          />
        ))}
      </div>
    </section>

  </main>
</Layout>
