---
import Layout from '../layouts/Layout.astro';
import MateriaCard from '../components/MateriaCard.astro';

import materiasData from '../data/materias.json';

const materias = materiasData.materias
  .filter((m: any) => m.activo)
  .sort((a: any, b: any) => a.orden - b.orden);
---

<Layout title="Aprende Jugando 🚀">
  <main id="dashboard-protegido" class="hidden max-w-5xl mx-auto px-4 py-8 md:py-12">

    <section class="mb-10">
      <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-500 via-brand-600 to-brand-700 p-6 md:p-10 shadow-xl">

        <div class="absolute -top-6 -right-6 text-[200px] leading-none opacity-10 select-none pointer-events-none">
          🦉
        </div>

        <div class="relative z-10">
          <h1 id="hero-saludo" class="text-3xl md:text-5xl font-extrabold text-white mb-3 leading-tight">
            ¡Hola, exploradora! 👋
          </h1>
          <p class="text-base md:text-lg text-white/90 font-bold mb-6">
            ¿Qué quieres aprender hoy? ✨
          </p>

          <div class="bg-white/15 backdrop-blur rounded-2xl p-4 max-w-md">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs md:text-sm font-extrabold text-white/90 uppercase tracking-wide">
                ⭐ Nivel 3 · Exploradora
              </span>
              <span class="text-xs md:text-sm font-extrabold text-white">
                120 / 200 XP
              </span>
            </div>
            <div class="w-full h-2.5 bg-white/20 rounded-full overflow-hidden">
              <div class="h-full bg-white rounded-full transition-all duration-700" style="width: 60%"></div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <section>
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl">📚</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
          Tus materias
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {materias.map((materia: any) => (
          <MateriaCard materia={materia} />
        ))}
      </div>
    </section>

  </main>

  <script>
    import { getAlumna, isLoggedIn } from '../lib/auth';

    if (!isLoggedIn()) {
      window.location.href = '/login';
    } else {
      const dashboard = document.getElementById('dashboard-protegido');
      dashboard?.classList.remove('hidden');

      const alumna = getAlumna();
      const saludo = document.getElementById('hero-saludo');
      if (alumna && saludo) {
        const primerNombre = alumna.nombre.split(' ')[0];
        saludo.textContent = `¡Hola, ${primerNombre}! 👋`;
      }
    }
  </script>
</Layout>
