---
import Layout from '../../layouts/Layout.astro';
import indiceLecturas from '../../data/materias/lenguaje/lecturas/indice.json';

export async function getStaticPaths() {
  const materiasFiles = import.meta.glob('../../data/materias/*/materia.json', { eager: true });

  const paths = [];
  for (const path in materiasFiles) {
    const data = (materiasFiles[path] as any).default;
    paths.push({
      params: { id: data.id },
      props: { materia: data },
    });
  }
  return paths;
}

const { materia } = Astro.props;

// Club de Lectura (solo para Lenguaje)
const tieneClubLectura = materia.id === 'lenguaje' && indiceLecturas.libros && indiceLecturas.libros.filter(l => l.activo).length > 0;
const librosActivos = tieneClubLectura ? indiceLecturas.libros.filter(l => l.activo) : [];

// Colores HEX directos por materia
const colores: Record<string, { c50: string; c100: string; c200: string; c400: string; c500: string; c600: string; c700: string }> = {
  lenguaje:     { c50: '#FDF2F8', c100: '#FCE7F3', c200: '#FBCFE8', c400: '#F472B6', c500: '#EC4899', c600: '#DB2777', c700: '#BE185D' },
  matematicas:  { c50: '#EFF6FF', c100: '#DBEAFE', c200: '#BFDBFE', c400: '#60A5FA', c500: '#3B82F6', c600: '#2563EB', c700: '#1D4ED8' },
  historia:     { c50: '#FFFBEB', c100: '#FEF3C7', c200: '#FDE68A', c400: '#FBBF24', c500: '#F59E0B', c600: '#D97706', c700: '#B45309' },
  ingles:       { c50: '#F0FDFA', c100: '#CCFBF1', c200: '#99F6E4', c400: '#2DD4BF', c500: '#14B8A6', c600: '#0D9488', c700: '#0F766E' },
  ciencias:     { c50: '#F7FEE7', c100: '#ECFCCB', c200: '#D9F99D', c400: '#A3E635', c500: '#84CC16', c600: '#65A30D', c700: '#4D7C0F' },
  programacion: { c50: '#FDF4FF', c100: '#FAE8FF', c200: '#F5D0FE', c400: '#E879F9', c500: '#D946EF', c600: '#C026D3', c700: '#A21CAF' },
};
const c = colores[materia.color] || colores.ciencias;

const estiloGradiente = `background: linear-gradient(135deg, ${c.c400} 0%, ${c.c600} 100%);`;
const estiloHero = `background: linear-gradient(135deg, ${c.c500} 0%, ${c.c600} 50%, ${c.c700} 100%);`;

const tieneSubmodulos = materia.submodulos && materia.submodulos.length > 0;
const tieneLecciones = materia.lecciones && materia.lecciones.length > 0;
const tieneCursos = materia.cursos_especiales && materia.cursos_especiales.length > 0;
---

<Layout title={`${materia.nombre} · Aprende Jugando`}>
  <main class="max-w-5xl mx-auto px-4 py-8 md:py-12">

    <!-- Botón volver -->
    <a
      href="/"
      class="inline-flex items-center gap-2 text-brand-600 font-bold mb-6 hover:gap-3 transition-all text-sm"
    >
      ← Volver al inicio
    </a>

    <!-- 🌟 HERO DE LA MATERIA -->
    <section class="mb-10">
      <div class="relative overflow-hidden rounded-[2rem] p-6 md:p-10 shadow-xl text-white" style={estiloHero}>
        <div class="absolute -top-6 -right-6 text-[180px] leading-none opacity-10 select-none pointer-events-none">
          {materia.emoji}
        </div>

        <div class="relative z-10 flex items-center gap-5">
          <div class="w-20 h-20 md:w-24 md:h-24 rounded-3xl bg-white/20 backdrop-blur flex items-center justify-center text-5xl md:text-6xl shadow-lg flex-shrink-0">
            {materia.emoji}
          </div>
          <div>
            <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-2">
              {materia.nombre}
            </h1>
            <p class="text-sm md:text-base text-white/90 font-bold">
              {materia.descripcion}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ✨ CURSOS ESPECIALES -->
    {tieneCursos && (
      <section class="mb-10">
        <div class="flex items-center gap-3 mb-5">
          <span class="text-3xl">✨</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
            Cursos Especiales
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {materia.cursos_especiales
            .filter((curso: any) => curso.activo !== false)
            .sort((a: any, b: any) => (a.orden || 0) - (b.orden || 0))
            .map((curso: any) => (
              <a
                href={`/curso/${curso.id}`}
                class="group block rounded-3xl p-6 shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 text-white relative overflow-hidden"
                style={estiloGradiente}
              >
                <div class="absolute -top-4 -right-4 text-[120px] leading-none opacity-10 select-none pointer-events-none">
                  {curso.emoji}
                </div>

                <div class="relative z-10">
                  <span class="inline-block text-xs font-extrabold px-3 py-1 rounded-full bg-white/20 backdrop-blur mb-4 tracking-wide uppercase">
                    ✨ Serie Especial
                  </span>

                  <div class="flex items-start gap-4 mb-4">
                    <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center text-3xl flex-shrink-0">
                      {curso.emoji}
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-lg md:text-xl font-extrabold leading-tight mb-1">
                        {curso.titulo}
                      </h3>
                      <p class="text-xs md:text-sm text-white/85 leading-snug">
                        {curso.subtitulo}
                      </p>
                    </div>
                  </div>

                  <span class="inline-flex items-center gap-1 font-bold text-sm group-hover:translate-x-1 transition-transform">
                    Descubrir <span class="text-base">→</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    )}

    <!-- 🧭 SUBMÓDULOS -->
    {tieneSubmodulos && (
      <section class="mb-10">
        <div class="flex items-center gap-3 mb-5">
          <span class="text-3xl">🧭</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
            Explora los submódulos
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {materia.submodulos
            .filter((s: any) => s.activo !== false)
            .sort((a: any, b: any) => a.orden - b.orden)
            .map((sub: any) => (
              <a
                href={`/submodulo/${materia.id}/${sub.id}`}
                class="group block bg-white rounded-3xl p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
              >
                <div
                  class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                  style={`background: linear-gradient(135deg, ${c.c50} 0%, white 100%);`}
                ></div>

                <div class="relative z-10 flex items-start gap-4">
                  <div
                    class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-sm flex-shrink-0 group-hover:scale-110 transition-transform"
                    style={`background: ${c.c100};`}
                  >
                    {sub.emoji}
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-extrabold text-gray-800 mb-1 leading-tight">
                      {sub.nombre}
                    </h3>
                    <p class="text-sm text-gray-500 mb-3 leading-snug">
                      {sub.descripcion}
                    </p>
                    <span
                      class="font-extrabold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                      style={`color: ${c.c500};`}
                    >
                      Explorar <span class="text-base">→</span>
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    )}

    <!-- 📚 LECCIONES DIRECTAS -->
    {tieneLecciones && (() => {
      const leccionesActivas = materia.lecciones
        .filter((l: any) => l.activa !== false)
        .sort((a: any, b: any) => a.orden - b.orden);
      const tieneGrupos = leccionesActivas.some((l: any) => l.grupo);
      const grupoLabels: Record<string, string> = {
        multiplicacion: 'Multiplicación',
        resta: 'Sustracción',
        division: 'División',
        fracciones: 'Fracciones',
      };
      const grupoEmojis: Record<string, string> = {
        multiplicacion: '🔢',
        resta: '➖',
        division: '➗',
        fracciones: '🍕',
      };
      const grupoDesc: Record<string, string> = {
        multiplicacion: 'Propiedades y operaciones de multiplicación',
        resta: 'Resta con reserva y problemas',
        division: 'Introducción, reparto y problemas',
        fracciones: 'Introducción, comparación y ordenamiento',
      };
      const groupOrder = ['multiplicacion', 'resta', 'division', 'fracciones', 'general'];
      const gruposMap: Record<string, any[]> = {};
      for (const lec of leccionesActivas) {
        const g = lec.grupo || 'general';
        if (!gruposMap[g]) gruposMap[g] = [];
        gruposMap[g].push(lec);
      }
      const grupos = Object.keys(gruposMap).sort(
        (a, b) => groupOrder.indexOf(a) - groupOrder.indexOf(b)
      );
      return (
        <>
          {/* VISTA DE CATEGORÍAS */}
          <div id="vista-categorias" class={tieneGrupos ? '' : 'hidden'}>
            {tieneGrupos && (
              <section class="mb-10">
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-3xl">📚</span>
                  <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
                    Categorías
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {grupos.map((g) => (
                    <button
                      type="button"
                      data-cat-grupo={g}
                      class="group relative block w-full text-left bg-white rounded-[1.75rem] p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
                    >
                      <div
                        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                        style={`background: linear-gradient(135deg, ${c.c50} 0%, white 100%);`}
                      ></div>
                      <div class="relative z-10">
                        <div class="flex items-start justify-between mb-5">
                          <div
                            class="w-16 h-16 md:w-20 md:h-20 rounded-3xl flex items-center justify-center text-4xl md:text-5xl shadow-md group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300"
                            style={`background: linear-gradient(135deg, ${c.c400} 0%, ${c.c600} 100%);`}
                          >
                            {grupoEmojis[g] || '📚'}
                          </div>
                          <span
                            class="text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wide"
                            style={`background: ${c.c100}; color: ${c.c700};`}
                          >
                            {gruposMap[g].length} lecciones
                          </span>
                        </div>
                        <h3 class="text-xl md:text-2xl font-extrabold text-gray-800 mb-2 leading-tight">
                          {grupoLabels[g] || g}
                        </h3>
                        <p class="text-sm text-gray-500 mb-4 leading-snug">
                          {grupoDesc[g] || ''}
                        </p>
                        <div class="flex items-center justify-end">
                          <span
                            class="font-extrabold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                            style={`color: ${c.c500};`}
                          >
                            Ver lecciones
                            <span class="text-base">→</span>
                          </span>
                        </div>
                      </div>
                    </button>
                  ))}
                </div>
              </section>
            )}
          </div>

          {/* VISTA DE LECCIONES */}
          <div id="vista-lecciones" class={tieneGrupos ? 'hidden' : ''}>
            {tieneGrupos && (
              <button
                id="volver-categorias"
                type="button"
                class="inline-flex items-center gap-2 text-brand-600 font-bold mb-6 hover:gap-3 transition-all text-sm"
              >
                ← Volver a categorías
              </button>
            )}
            {grupos.map((g) => (
              <section data-lec-grupo={g} class="mb-10 hidden">
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-3xl">{grupoEmojis[g] || '📚'}</span>
                  <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
                    {grupoLabels[g] || g}
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {gruposMap[g].map((lec: any) => (
                    <a
                      href={`/leccion/${materia.id}/${lec.id}`}
                      class="group block bg-white rounded-3xl p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
                    >
                      <div
                        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                        style={`background: linear-gradient(135deg, ${c.c50} 0%, white 100%);`}
                      ></div>
                      <div class="relative z-10">
                        <div class="flex items-start justify-between mb-4">
                          <div
                            class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-sm group-hover:scale-110 transition-transform"
                            style={`background: ${c.c100};`}
                          >
                            {lec.emoji}
                          </div>
                          {lec.nivel && (
                            <span
                              class="text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wide"
                              style={`background: ${c.c100}; color: ${c.c700};`}
                            >
                              {lec.nivel}
                            </span>
                          )}
                        </div>
                        <h3 class="text-lg font-extrabold text-gray-800 mb-1 leading-tight">
                          {lec.titulo}
                        </h3>
                        {lec.duracion_estimada_min && (
                          <p class="text-xs text-gray-400 font-bold mb-3">
                            ⏱️ ~{lec.duracion_estimada_min} min
                          </p>
                        )}
                        <span
                          class="font-extrabold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                          style={`color: ${c.c500};`}
                        >
                          Empezar <span class="text-base">→</span>
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))}
            {!tieneGrupos && (
              <section class="mb-10">
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-3xl">📚</span>
                  <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
                    Lecciones
                  </h2>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {leccionesActivas.map((lec: any) => (
                    <a
                      href={`/leccion/${materia.id}/${lec.id}`}
                      class="group block bg-white rounded-3xl p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
                    >
                      <div
                        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                        style={`background: linear-gradient(135deg, ${c.c50} 0%, white 100%);`}
                      ></div>
                      <div class="relative z-10">
                        <div class="flex items-start justify-between mb-4">
                          <div
                            class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-sm group-hover:scale-110 transition-transform"
                            style={`background: ${c.c100};`}
                          >
                            {lec.emoji}
                          </div>
                          {lec.nivel && (
                            <span
                              class="text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wide"
                              style={`background: ${c.c100}; color: ${c.c700};`}
                            >
                              {lec.nivel}
                            </span>
                          )}
                        </div>
                        <h3 class="text-lg font-extrabold text-gray-800 mb-1 leading-tight">
                          {lec.titulo}
                        </h3>
                        {lec.duracion_estimada_min && (
                          <p class="text-xs text-gray-400 font-bold mb-3">
                            ⏱️ ~{lec.duracion_estimada_min} min
                          </p>
                        )}
                        <span
                          class="font-extrabold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                          style={`color: ${c.c500};`}
                        >
                          Empezar <span class="text-base">→</span>
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>
        </>
      );
    })()}
    <script>
      (function () {
        const catView = document.getElementById('vista-categorias');
        const lecView = document.getElementById('vista-lecciones');
        const backBtn = document.getElementById('volver-categorias');
        function showGroup(g) {
          if (!catView || !lecView) return;
          catView.classList.add('hidden');
          lecView.classList.remove('hidden');
          lecView.querySelectorAll('section[data-lec-grupo]').forEach((sec) => {
            if (sec.getAttribute('data-lec-grupo') === g) {
              sec.classList.remove('hidden');
            } else {
              sec.classList.add('hidden');
            }
          });
        }
        document.querySelectorAll('[data-cat-grupo]').forEach((btn) => {
          btn.addEventListener('click', () => showGroup(btn.getAttribute('data-cat-grupo')));
        });
        if (backBtn) {
          backBtn.addEventListener('click', () => {
            if (lecView) lecView.classList.add('hidden');
            if (catView) catView.classList.remove('hidden');
            lecView.querySelectorAll('section[data-lec-grupo]').forEach((sec) => sec.classList.add('hidden'));
          });
        }
      })();
    </script>
    <!-- 📚 CLUB DE LECTURA (solo en Lenguaje) -->
    {materia.id === 'lenguaje' && (
      <section class="mb-10">
        <div class="flex items-center gap-3 mb-5">
          <span class="text-3xl">📚</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-800">
            Club de Lectura
          </h2>
        </div>

        <a
          href="/lenguaje"
          class="group block bg-white rounded-3xl p-6 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
            style={`background: linear-gradient(135deg, ${c.c50} 0%, white 100%);`}
          ></div>

          <div class="relative z-10 flex items-start gap-4">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl shadow-sm flex-shrink-0 group-hover:scale-110 transition-transform"
              style={`background: ${c.c100};`}
            >
              📖
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-extrabold text-gray-800 mb-1 leading-tight">
                Club de Lectura
              </h3>
              <p class="text-sm text-gray-500 mb-3 leading-snug">
                Ejercicios de comprensión lectora con preguntas que rotan. Cada sesión es diferente.
              </p>
              <span
                class="font-extrabold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                style={`color: ${c.c500};`}
              >
                Entrar al Club <span class="text-base">→</span>
              </span>
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- ESTADO VACÍO -->
    {!tieneSubmodulos && !tieneLecciones && !tieneCursos && materia.id !== 'lenguaje' && (
      <div class="bg-white rounded-3xl p-10 text-center shadow-sm border border-gray-100">
        <div class="text-6xl mb-4">🚧</div>
        <h3 class="text-xl font-extrabold text-gray-800 mb-2">
          Próximamente
        </h3>
        <p class="text-gray-500">
          Estamos preparando contenido para esta materia.
        </p>
      </div>
    )}

  </main>
</Layout>
